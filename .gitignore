# Build output
bin/
obj/
publish/
*.user
*.suo
.vs/
.vscode/
.idea/
TestResults/

# Local runtime data: SQLite database, uploaded study material, Data Protection keys.
# All of these live under ./data when running locally (see appsettings.Development.json)
# and in a Docker volume in production - they must never be committed.
# Anchored paths: git on Windows ignores case, so a bare "data/" would also hide src/LearningPortal.Core/Data.
/data/
/src/LearningPortal.Web/data/
**/keys/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

# Secrets and machine-local configuration
.env
.env.*
!.env.example
appsettings.*.local.json
secrets.json
*.pfx
*.pem
*.key

# Claude Code machine-local settings (the shared settings.json stays tracked)
.claude/settings.local.json

# OS noise
Thumbs.db
.DS_Store

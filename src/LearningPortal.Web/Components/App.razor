@using System.Security.Claims

<!DOCTYPE html>
<html lang="en" data-theme="@ThemeAttr">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    @* Before any paint: "system" becomes light or dark from the device, and follows it when it changes.
       Settings calls lpApplyTheme to switch without a reload. *@
    <script>
        (function () {
            var media = window.matchMedia("(prefers-color-scheme: light)"), pref;
            window.lpApplyTheme = function (p) {
                pref = p;
                document.documentElement.dataset.theme = p === "system" ? (media.matches ? "light" : "dark") : p;
            };
            media.addEventListener("change", function () { if (pref === "system") window.lpApplyTheme(pref); });
            window.lpApplyTheme(document.documentElement.dataset.theme);
        })();
    </script>
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="fonts/atkinsonhyperlegiblenext-2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["LearningPortal.Web.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["lib/highlight/highlight.min.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [Inject]
    private SettingsService Settings { get; set; } = default!;

    // Signed-out pages (login, first-run setup) use the default.
    private Theme _theme = Theme.Dark;

    private string ThemeAttr => _theme.ToString().ToLowerInvariant();

    protected override async Task OnInitializedAsync()
    {
        if (HttpContext.User.FindFirstValue(ClaimTypes.NameIdentifier) is { } userId)
            _theme = await Settings.GetThemeAsync(userId, HttpContext.RequestAborted);
    }

    // Account pages (login, first-run setup, password change) render as plain server-side forms
    // because they set the auth cookie; everything else is interactive, without prerendering.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}

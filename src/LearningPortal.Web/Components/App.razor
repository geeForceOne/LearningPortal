<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="preload" href="fonts/atkinsonhyperlegiblenext-2.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="@Assets["fonts/fonts.css"]" />
    <link rel="stylesheet" href="@Assets["css/app.css"]" />
    <link rel="stylesheet" href="@Assets["LearningPortal.Web.styles.css"]" />
    <link rel="icon" type="image/svg+xml" href="@Assets["favicon.svg"]" />
    <ImportMap />
    <HeadOutlet @rendermode="PageRenderMode" />
</head>

<body>
    <Routes @rendermode="PageRenderMode" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
    <script src="@Assets["js/app.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    // Account pages (login, first-run setup, password change) render as plain server-side forms
    // because they set the auth cookie; everything else is interactive, without prerendering.
    private IComponentRenderMode? PageRenderMode =>
        HttpContext.AcceptsInteractiveRouting() ? new InteractiveServerRenderMode(prerender: false) : null;
}

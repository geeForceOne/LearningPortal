@page "/account/set-password"
@attribute [AllowAnonymous]
@inject AccountMailService Mail
@inject SignInManager<AppUser> SignInManager
@inject NavigationManager Nav

<PageTitle>@(IsInvite ? "Welcome" : "Choose a new password") - @AppInfo.Name</PageTitle>

<div class="auth-form">
    <h1>@(IsInvite ? $"Welcome to {AppInfo.Name}" : "Choose a new password")</h1>

    @if (_linkError is not null)
    {
        <div class="notice notice-error" style="margin-bottom:18px">@_linkError</div>
        @if (IsInvite)
        {
            <p><a href="account/login">Go to sign in</a></p>
        }
        else
        {
            <p><a href="account/forgot">Request a new reset link</a></p>
        }
    }
    else
    {
        <p class="page-sub">
            @(IsInvite ? "Choose a password for your account. You'll be signed in straight away." : "After this you'll be signed in with the new password.")
        </p>

        @if (_errors.Count > 0)
        {
            <div class="notice notice-error" style="margin-bottom:18px">
                @foreach (var e in _errors)
                {
                    <div>@e</div>
                }
            </div>
        }

        <EditForm Model="Input" method="post" OnValidSubmit="SetAsync" FormName="set-password" class="form">
            <DataAnnotationsValidator />
            <label class="field">
                <span>New password</span>
                <InputText type="password" @bind-Value="Input!.Password" class="input" autocomplete="new-password" autofocus />
                <span class="field-hint">At least 8 characters.</span>
                <ValidationMessage For="() => Input!.Password" />
            </label>
            <label class="field">
                <span>Repeat password</span>
                <InputText type="password" @bind-Value="Input!.Confirm" class="input" autocomplete="new-password" />
                <ValidationMessage For="() => Input!.Confirm" />
            </label>
            <button type="submit" class="btn btn-primary btn-lg">@(IsInvite ? "Set password and sign in" : "Save and sign in")</button>
        </EditForm>
    }
</div>

@code {
    private string? _linkError;
    private readonly List<string> _errors = [];

    [SupplyParameterFromQuery(Name = "user")]
    private string? UserId { get; set; }

    [SupplyParameterFromQuery(Name = "code")]
    private string? Code { get; set; }

    [SupplyParameterFromQuery(Name = "kind")]
    private string? KindParam { get; set; }

    [SupplyParameterFromForm]
    private SetPasswordInput? Input { get; set; }

    private PasswordLinkKind Kind => KindParam == "invite" ? PasswordLinkKind.Invite : PasswordLinkKind.Reset;
    private bool IsInvite => Kind == PasswordLinkKind.Invite;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        // Checked on first view too, so an expired link says so before the person types a password.
        _linkError = await Mail.CheckLinkAsync(UserId, Code, Kind);
    }

    private async Task SetAsync()
    {
        var (user, errors) = await Mail.SetPasswordAsync(UserId, Code, Kind, Input!.Password);
        if (user is null)
        {
            _errors.AddRange(errors);
            return;
        }

        await SignInManager.SignInAsync(user, isPersistent: true);
        Nav.NavigateTo(IsInvite ? "/settings" : "/", forceLoad: true);
    }

    private sealed class SetPasswordInput
    {
        [Required(ErrorMessage = "Choose a password.")]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string Confirm { get; set; } = "";
    }
}

@page "/account/setup"
@attribute [AllowAnonymous]
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav
@inject UserAdminService Users

<PageTitle>Set up - @AppInfo.Name</PageTitle>

<div class="auth-form">
    <h1>Create the admin account</h1>
    <p class="page-sub">
        This is a fresh installation. The account you create now is the administrator. After this,
        only you can add accounts for other people.
    </p>

    @if (_errors.Count > 0)
    {
        <div class="notice notice-error" style="margin-bottom:18px">
            @foreach (var e in _errors)
            {
                <div>@e</div>
            }
        </div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="CreateAsync" FormName="setup" class="form">
        <DataAnnotationsValidator />
        <label class="field">
            <span>Email address</span>
            <InputText type="email" @bind-Value="Input.Email" class="input" autocomplete="username" autofocus />
            <span class="field-hint">You sign in with this. It's also where a forgotten-password link goes.</span>
            <ValidationMessage For="() => Input.Email" />
        </label>
        <label class="field">
            <span>Display name <span class="muted">(optional)</span></span>
            <InputText @bind-Value="Input.DisplayName" class="input" autocomplete="nickname" maxlength="@AppUser.MaxDisplayNameLength" />
            <span class="field-hint">What @AppInfo.Name calls you. Without one, the first part of your email is used.</span>
            <ValidationMessage For="() => Input.DisplayName" />
        </label>
        <label class="field">
            <span>Password</span>
            <InputText type="password" @bind-Value="Input.Password" class="input" autocomplete="new-password" />
            <span class="field-hint">At least 8 characters.</span>
            <ValidationMessage For="() => Input.Password" />
        </label>
        <label class="field">
            <span>Repeat password</span>
            <InputText type="password" @bind-Value="Input.Confirm" class="input" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Confirm" />
        </label>
        <button type="submit" class="btn btn-primary btn-lg">Create admin account</button>
    </EditForm>
</div>

@code {
    private readonly List<string> _errors = [];

    [SupplyParameterFromForm]
    private SetupInput Input { get; set; } = new();

    protected override void OnInitialized()
    {
        if (UserManager.Users.Any())
            Nav.NavigateTo("account/login");
    }

    private async Task CreateAsync()
    {
        // Checked again at submit time so two people racing the setup page can't both become admin.
        if (UserManager.Users.Any())
        {
            Nav.NavigateTo("account/login");
            return;
        }

        if (await Users.CheckEmailAsync(Input.Email, exceptUserId: null) is { } emailError)
        {
            _errors.Add(emailError);
            return;
        }

        // Signs in with the email, which is also the internal UserName (as for every new account).
        var email = Input.Email.Trim();
        var user = new AppUser
        {
            UserName = email,
            Email = email,
            DisplayName = string.IsNullOrWhiteSpace(Input.DisplayName) ? null : Input.DisplayName.Trim(),
        };
        var result = await UserManager.CreateAsync(user, Input.Password);
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors.Select(e => e.Description));
            return;
        }

        await UserManager.AddToRoleAsync(user, Roles.Admin);
        await SignInManager.SignInAsync(user, isPersistent: true);
        Nav.NavigateTo("/settings", forceLoad: true);
    }

    private sealed class SetupInput
    {
        [Required(ErrorMessage = "Enter your email address.")]
        [EmailAddress(ErrorMessage = "That doesn't look like an email address.")]
        public string Email { get; set; } = "";

        [MaxLength(AppUser.MaxDisplayNameLength, ErrorMessage = "Keep the display name shorter.")]
        public string? DisplayName { get; set; }

        [Required(ErrorMessage = "Choose a password.")]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string Password { get; set; } = "";

        [Compare(nameof(Password), ErrorMessage = "The passwords don't match.")]
        public string Confirm { get; set; } = "";
    }
}

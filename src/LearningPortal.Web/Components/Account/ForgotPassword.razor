@page "/account/forgot"
@attribute [AllowAnonymous]
@inject AccountMailService Mail
@inject NavigationManager Nav

<PageTitle>Forgot password - @AppInfo.Name</PageTitle>

<div class="auth-form">
    <p class="crumbs"><a href="account/login">Back to sign in</a></p>
    <h1>Forgot password</h1>

    @if (!_emailOn)
    {
        <p class="page-sub">
            This server can't send email, so passwords can't be reset from here. Ask your administrator
            for a reset link.
        </p>
    }
    else if (_sent)
    {
        <div class="notice notice-good" role="status">
            If an account matches what you entered and has an email address, a reset link is on its way.
            It expires in @((int)AccountMailService.ResetLifespan.TotalHours) hours. Check the spam folder if
            it doesn't arrive within a few minutes.
        </div>
    }
    else
    {
        <p class="page-sub">Enter your username or email address and we'll email you a link to choose a new password.</p>

        <EditForm Model="Input" method="post" OnValidSubmit="SendAsync" FormName="forgot-password" class="form">
            <DataAnnotationsValidator />
            <label class="field">
                <span>Username or email address</span>
                <InputText @bind-Value="Input!.UserNameOrEmail" class="input" autocomplete="username" autofocus />
                <ValidationMessage For="() => Input!.UserNameOrEmail" />
            </label>
            <button type="submit" class="btn btn-primary btn-lg">Send reset link</button>
        </EditForm>
    }
</div>

@code {
    private bool _sent;
    private bool _emailOn;

    [SupplyParameterFromForm]
    private ForgotInput? Input { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();
        _emailOn = await Mail.EmailConfiguredAsync();
    }

    private async Task SendAsync()
    {
        await Mail.RequestResetAsync(Input!.UserNameOrEmail, Nav.BaseUri);
        _sent = true;
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Enter your username or email address.")]
        public string UserNameOrEmail { get; set; } = "";
    }
}

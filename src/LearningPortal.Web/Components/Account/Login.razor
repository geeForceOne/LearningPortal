@page "/account/login"
@attribute [AllowAnonymous]
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<PageTitle>Sign in - LearningPortal</PageTitle>

<div class="auth-form">
    <h1>Sign in</h1>
    <p class="page-sub">Use the username and password your administrator gave you.</p>

    @if (_error is not null)
    {
        <div class="notice notice-error" style="margin-bottom:18px">@_error</div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="login" class="form">
        <DataAnnotationsValidator />
        <label class="field">
            <span>Username</span>
            <InputText @bind-Value="Input.UserName" class="input" autocomplete="username" autofocus />
            <ValidationMessage For="() => Input.UserName" />
        </label>
        <label class="field">
            <span>Password</span>
            <InputText type="password" @bind-Value="Input.Password" class="input" autocomplete="current-password" />
            <ValidationMessage For="() => Input.Password" />
        </label>
        <label class="check">
            <InputCheckbox @bind-Value="Input.RememberMe" />
            Keep me signed in on this device
        </label>
        <button type="submit" class="btn btn-primary btn-lg">Sign in</button>
    </EditForm>
</div>

@code {
    private string? _error;

    [SupplyParameterFromForm]
    private LoginInput Input { get; set; } = new();

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override void OnInitialized()
    {
        // No accounts yet: the first person to arrive sets up the admin account.
        if (!UserManager.Users.Any())
            Nav.NavigateTo("account/setup");
    }

    private async Task SignInAsync()
    {
        var result = await SignInManager.PasswordSignInAsync(Input.UserName.Trim(), Input.Password, Input.RememberMe, lockoutOnFailure: true);
        if (result.Succeeded)
        {
            Nav.NavigateTo(SafeReturnUrl(ReturnUrl), forceLoad: true);
            return;
        }

        _error = result.IsLockedOut
            ? "This account is locked for a few minutes after too many failed attempts. Try again later."
            : "That username and password don't match. Check both and try again.";
    }

    // Only same-site paths, so the login page can't be used to bounce people to another site.
    private static string SafeReturnUrl(string? url) =>
        !string.IsNullOrEmpty(url) && url.StartsWith('/') && !url.StartsWith("//") && !url.StartsWith("/\\") ? url : "/";

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Enter your username.")]
        public string UserName { get; set; } = "";

        [Required(ErrorMessage = "Enter your password.")]
        public string Password { get; set; } = "";

        public bool RememberMe { get; set; } = true;
    }
}

@page "/account/password"
@inject SignInManager<AppUser> SignInManager
@inject UserManager<AppUser> UserManager
@inject NavigationManager Nav

<PageTitle>Change password - LearningPortal</PageTitle>

<div class="auth-form">
    <p class="crumbs"><a href="">Back to LearningPortal</a></p>
    <h1>Change password</h1>
    <p class="page-sub">You'll stay signed in on this device.</p>

    @if (_done)
    {
        <div class="notice notice-good" style="margin-bottom:18px">Password changed.</div>
    }
    @if (_errors.Count > 0)
    {
        <div class="notice notice-error" style="margin-bottom:18px">
            @foreach (var e in _errors)
            {
                <div>@e</div>
            }
        </div>
    }

    <EditForm Model="Input" method="post" OnValidSubmit="ChangeAsync" FormName="change-password" class="form">
        <DataAnnotationsValidator />
        <label class="field">
            <span>Current password</span>
            <InputText type="password" @bind-Value="Input.Current" class="input" autocomplete="current-password" />
            <ValidationMessage For="() => Input.Current" />
        </label>
        <label class="field">
            <span>New password</span>
            <InputText type="password" @bind-Value="Input.New" class="input" autocomplete="new-password" />
            <span class="field-hint">At least 8 characters.</span>
            <ValidationMessage For="() => Input.New" />
        </label>
        <label class="field">
            <span>Repeat new password</span>
            <InputText type="password" @bind-Value="Input.Confirm" class="input" autocomplete="new-password" />
            <ValidationMessage For="() => Input.Confirm" />
        </label>
        <button type="submit" class="btn btn-primary btn-lg">Change password</button>
    </EditForm>
</div>

@code {
    private readonly List<string> _errors = [];
    private bool _done;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private PasswordInput Input { get; set; } = new();

    private async Task ChangeAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            Nav.NavigateTo("account/login", forceLoad: true);
            return;
        }

        var result = await UserManager.ChangePasswordAsync(user, Input.Current, Input.New);
        if (!result.Succeeded)
        {
            _errors.AddRange(result.Errors.Select(e => e.Code == "PasswordMismatch" ? "The current password is wrong." : e.Description));
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        _done = true;
        Input = new();
    }

    private sealed class PasswordInput
    {
        [Required(ErrorMessage = "Enter your current password.")]
        public string Current { get; set; } = "";

        [Required(ErrorMessage = "Choose a new password.")]
        [MinLength(8, ErrorMessage = "Use at least 8 characters.")]
        public string New { get; set; } = "";

        [Compare(nameof(New), ErrorMessage = "The passwords don't match.")]
        public string Confirm { get; set; } = "";
    }
}

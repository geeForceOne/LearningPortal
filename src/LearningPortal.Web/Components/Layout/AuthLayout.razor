@inherits LayoutComponentBase

<div class="auth">
    <aside class="auth-side">
        <div>
            <a class="auth-brand" href="">
                <BrandMark Size="140" />
                <span class="auth-name">@AppInfo.Name</span>
            </a>
            <p class="auth-dedication">@AppInfo.Dedication</p>
        </div>
        <p class="auth-quote">@AppInfo.Tagline</p>
        <div class="muted small">
            <p>Your topics and results are private to your account.</p>
            <a class="auth-version" href="release-notes" title="Release notes">@AppInfo.Name @AppInfo.Version</a>
        </div>
    </aside>
    <main class="auth-main">
        @Body
    </main>
</div>

@inherits LayoutComponentBase

<div class="auth">
    <aside class="auth-side">
        <div>
            <a class="auth-brand" href="">
                <BrandMark Size="140" />
                <span class="auth-name">@AppInfo.Name</span>
            </a>
            <p class="auth-dedication">@AppInfo.Dedication</p>
        </div>
        <p class="auth-quote">@AppInfo.Tagline</p>
        <p class="muted small">Your topics and results are private to your account.</p>
    </aside>
    <main class="auth-main">
        @Body
    </main>
</div>

@* Shown by Blazor when the connection to the server drops (an update restarting the container, a
   laptop waking up). Blazor finds it by its id and sets the state classes; ReconnectModal.razor.js
   opens and closes it and wires the buttons. Based on the .NET 10 template, styled in app.css
   ("Reconnect dialog"). *@
<script type="module" src="@Assets["Components/Layout/ReconnectModal.razor.js"]"></script>

<dialog id="components-reconnect-modal" data-nosnippet>
    <div class="components-reconnect-container">
        <div class="components-rejoining-animation" aria-hidden="true">
            <BrandMark Size="48" Busy="true" />
        </div>
        <p class="components-reconnect-first-attempt-visible">
            Reconnecting to Recall...
        </p>
        <p class="components-reconnect-repeated-attempt-visible">
            Couldn't reconnect. Trying again in <span id="components-seconds-to-next-attempt"></span> seconds...
        </p>
        <p class="components-reconnect-failed-visible">
            Couldn't reconnect to Recall.<br />Retry, or reload the page.
        </p>
        <button id="components-reconnect-button" type="button" class="btn btn-primary components-reconnect-failed-visible">
            Retry
        </button>
        <p class="components-pause-visible">
            The server paused this session.
        </p>
        <p class="components-resume-failed-visible">
            Couldn't resume the session.<br />Retry, or reload the page.
        </p>
        <button id="components-resume-button" type="button" class="btn btn-primary components-pause-visible components-resume-failed-visible">
            Resume
        </button>
    </div>
</dialog>

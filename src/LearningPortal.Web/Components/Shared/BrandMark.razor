@* An index card with one line highlighted: the app's mark. *@
<svg width="@Size" height="@Size" viewBox="0 0 32 32" aria-hidden="true">
    <rect x="3" y="7" width="26" height="18" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M8 14h16" stroke="var(--marker)" stroke-width="5" stroke-linecap="round" />
    <path d="M8 20h9" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
</svg>

@code {
    [Parameter] public int Size { get; set; } = 26;
}

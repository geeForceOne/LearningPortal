@* The admin's "New account" form. The page passes in the create step, so errors such as an email
   already in use show here and the dialog stays open with what was typed. *@
@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="create-account-title">
            <h2 id="create-account-title">New account</h2>
            <form class="form" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>Email address</span>
                    <input class="input" type="email" @bind="_email" @bind:event="oninput" @onkeydown="OnKeyDown" @ref="_emailInput"
                           autocomplete="off" spellcheck="false" />
                    <span class="field-hint">
                        They sign in with this.
                        @(_emailOn ? "The invite link goes here too." : "Email isn't set up, so you'll get the invite link to pass on yourself.")
                    </span>
                </label>
                <label class="field">
                    <span>Display name <span class="muted">(optional)</span></span>
                    <input class="input" @bind="_name" @bind:event="oninput" @onkeydown="OnKeyDown" autocomplete="off" maxlength="@AppUser.MaxDisplayNameLength" />
                    <span class="field-hint">Without one, the first part of their email is shown. They can change it later.</span>
                </label>
                <label class="check">
                    <input type="checkbox" @bind="_admin" /> Administrator
                </label>
                @foreach (var e in _errors)
                {
                    <div class="field-error">@e</div>
                }
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="() => Resolve(false)">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@(_busy || string.IsNullOrWhiteSpace(_email))">
                        @(_emailOn ? "Create and send invite" : "Create account")
                    </button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    public sealed record NewAccount(string Email, string DisplayName, bool IsAdmin);

    private bool _visible;
    private bool _focusPending;
    private bool _emailOn;
    private bool _busy;
    private string _email = "";
    private string _name = "";
    private bool _admin;
    private IReadOnlyList<string> _errors = [];
    private Func<NewAccount, Task<IReadOnlyList<string>>> _create = default!;
    private ElementReference _emailInput;
    private TaskCompletionSource<bool>? _tcs;

    // Resolves to true once create succeeded (it returns no errors), false if cancelled.
    public Task<bool> AskAsync(bool emailOn, Func<NewAccount, Task<IReadOnlyList<string>>> create)
    {
        _tcs?.TrySetResult(false);
        _emailOn = emailOn;
        _create = create;
        _email = "";
        _name = "";
        _admin = false;
        _errors = [];
        _busy = false;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _emailInput.FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            Resolve(false);
    }

    private async Task SubmitAsync()
    {
        if (_busy || string.IsNullOrWhiteSpace(_email)) return;
        _busy = true;
        try
        {
            _errors = await _create(new NewAccount(_email, _name, _admin));
        }
        finally
        {
            _busy = false;
        }
        if (_errors.Count == 0)
            Resolve(true);
    }

    private void Resolve(bool result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}

@* The revealed state of one question: the right answer highlighted, what you picked or wrote,
   the grade, the explanation you learn from, and follow-up questions to the AI. Used after
   "Reveal answer" and on results. A bad question can be flagged from here. *@
@using System.Security.Claims
@inject ExamService Exams

@if (Q.Type == QuestionType.MultipleChoice)
{
    <div class="options locked @(Q.AllowsMultiple ? "multi" : "")" role="list">
        @foreach (var o in OrderedOptions)
        {
            var picked = Answer.SelectedIds.Contains(o.Id);
            <div class="option @(o.IsCorrect ? "is-key" : picked ? "is-wrong-pick" : "")" role="listitem">
                <input type="@(Q.AllowsMultiple ? "checkbox" : "radio")" checked="@picked" disabled tabindex="-1" aria-hidden="true" />
                <span class="option-box"></span>
                <span class="option-text"><RichText Text="@o.Text" /></span>
                @if (o.IsCorrect && picked)
                {
                    <span class="option-mark">Your pick, correct</span>
                }
                else if (o.IsCorrect)
                {
                    <span class="option-mark">Correct</span>
                }
                else if (picked)
                {
                    <span class="option-mark">Your pick</span>
                }
            </div>
        }
    </div>
}
else
{
    <div class="your-answer">
        <h3 class="small muted" style="margin-bottom:6px">Your answer</h3>
        @if (Answer.DontKnow)
        {
            <p class="muted">You said you didn't know.</p>
        }
        else if (string.IsNullOrWhiteSpace(Answer.WrittenAnswer))
        {
            <p class="muted">Not answered.</p>
        }
        else
        {
            <div class="reading">@Answer.WrittenAnswer</div>
        }
    </div>
}

<div class="result-line">
    @if (!Answer.IsAnswered)
    {
        <span class="verdict verdict-incorrect">Not answered</span>
    }
    else if (Answer.DontKnow)
    {
        <span class="verdict verdict-incorrect">You didn't know</span>
    }
    else if (Answer.Score is { } score)
    {
        <VerdictLabel Score="score" ShowScore="@(Q.Type == QuestionType.Written || Q.AllowsMultiple)" />
    }
    else
    {
        <span class="muted small">Not graded yet.</span>
        @if (OnRetryGrade.HasDelegate)
        {
            <button type="button" class="btn btn-secondary btn-sm" @onclick="OnRetryGrade">Grade now</button>
        }
    }
    <span class="spacer" style="flex:1"></span>
    <AnswerOrigin Source="Q.AnswerSource" />
    <SourceLink Question="Q" />
    @if (Q.IsFlagged)
    {
        <span class="tag tag-flag"><Icon Name="flag" Size="12" /> Flagged</span>
        <button type="button" class="link-button source-link" disabled="@_flagging" @onclick="() => SetFlaggedAsync(false)">Remove flag</button>
    }
    else
    {
        <button type="button" class="link-button source-link" disabled="@_flagging"
                title="Ambiguous, wrong or off-topic? A flagged question isn't reused in new exams or in practice."
                @onclick="() => SetFlaggedAsync(true)">
            <Icon Name="flag" Size="14" /> Flag as a bad question
        </button>
    }
</div>

@if (!string.IsNullOrWhiteSpace(Answer.Feedback))
{
    <RichText Class="feedback" Text="@Answer.Feedback" />
}

@if (Q.Type == QuestionType.Written)
{
    <div class="reference">
        <h3>Reference answer</h3>
        <RichText Class="reading" Text="@Q.ReferenceAnswer" />
    </div>
}

<div class="explain">
    <h3>Why</h3>
    <RichText Class="reading" Text="@Q.Explanation" />
</div>
<AnswerOrigin WebSources="Q.WebSources" ShowSources="true" />

@if (AttemptId is { } attemptId)
{
    <FollowUps AttemptId="attemptId" Answer="Answer" />
}

@code {
    [Parameter, EditorRequired] public AttemptAnswer Answer { get; set; } = default!;
    [Parameter] public EventCallback OnRetryGrade { get; set; }
    // Set to offer follow-up questions to the AI about this answer.
    [Parameter] public int? AttemptId { get; set; }

    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private bool _flagging;

    private Question Q => Answer.Question!;

    private async Task SetFlaggedAsync(bool flagged)
    {
        var state = AuthState is null ? null : await AuthState;
        if (state?.User.FindFirstValue(ClaimTypes.NameIdentifier) is not { } userId)
            return;
        _flagging = true;
        try
        {
            await Exams.SetFlaggedAsync(userId, Q.Id, flagged);
            Q.IsFlagged = flagged;
            Ui.Toast.Success(flagged
                ? "Flagged. Recall won't reuse this question in new exams or in practice. It stays in this exam until you replace or remove it there."
                : "Flag removed.");
        }
        catch (NotFoundException ex)
        {
            Ui.Toast.Error(ex.Message);
        }
        finally
        {
            _flagging = false;
        }
    }

    // Options in the order this attempt showed them.
    private IEnumerable<QuestionOption> OrderedOptions
    {
        get
        {
            var order = Answer.OptionOrderIds.ToList();
            return Q.Options.OrderBy(o => order.IndexOf(o.Id) is var i and >= 0 ? i : int.MaxValue);
        }
    }
}

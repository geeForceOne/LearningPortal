@* Where a question came from: the material and section it was written about, or the uploaded
   exam paper when no section answers it. *@
@if (Question.IsUserAuthored)
{
    <span class="source-link"><Icon Name="edit" Size="14" /> Written by you</span>
}
else if (Question.SourceMaterialId is not null)
{
    <a class="source-link" href="@Href">
        <Icon Name="file" Size="14" /> From @(Question.SourceLabel ?? "your material")
    </a>
}
else if (Question.SourceLabel is not null)
{
    <span class="source-link"><Icon Name="file" Size="14" /> From @Question.SourceLabel (material since deleted)</span>
}
else if (Question.ImportedFrom is not null)
{
    <span class="source-link"><Icon Name="file" Size="14" /> From your paper @Question.ImportedFrom</span>
}

@code {
    [Parameter, EditorRequired] public Question Question { get; set; } = default!;

    private string Href => Question.SourceSectionId is { } section
        ? $"materials/{Question.SourceMaterialId}#section-{section}"
        : $"materials/{Question.SourceMaterialId}";
}

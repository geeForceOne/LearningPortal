@if (_visible)
{
    <div class="modal-backdrop" @onclick="() => Resolve(false)">
        <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="confirm-title" @onclick:stopPropagation="true"
             @onkeydown="OnKeyDown" tabindex="-1" @ref="_root">
            <h2 id="confirm-title">@_title</h2>
            <p>@_message</p>
            <div class="modal-actions">
                <button type="button" class="btn btn-ghost" @onclick="() => Resolve(false)">Cancel</button>
                <button type="button" class="btn @(_danger ? "btn-danger-solid" : "btn-primary")" @onclick="() => Resolve(true)">@_confirmLabel</button>
            </div>
        </div>
    </div>
}

@code {
    private bool _visible;
    private bool _focusPending;
    private string _title = "";
    private string _message = "";
    private string _confirmLabel = "";
    private bool _danger;
    private ElementReference _root;
    private TaskCompletionSource<bool>? _tcs;

    // Awaited by the caller: `if (!await Ui.Confirm.AskAsync(...)) return;`
    public Task<bool> AskAsync(string title, string message, string confirmLabel, bool danger = false)
    {
        _tcs?.TrySetResult(false);
        _title = title;
        _message = message;
        _confirmLabel = confirmLabel;
        _danger = danger;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<bool>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _root.FocusAsync(); } catch (JSException) { }
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") Resolve(false);
    }

    private void Resolve(bool result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}

@if (_visible)
{
    <div class="modal-backdrop" @onclick="() => Resolve(null)">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="topic-dialog-title" @onclick:stopPropagation="true">
            <h2 id="topic-dialog-title">@_title</h2>
            <form class="form" @onsubmit="Submit" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>Name</span>
                    <input class="input" @bind="_name" @bind:event="oninput" @ref="_nameInput" maxlength="200" placeholder="e.g. Cell biology" />
                </label>
                <label class="field">
                    <span>Language</span>
                    <input class="input" @bind="_language" @bind:event="oninput" list="topic-languages" maxlength="80" />
                    <datalist id="topic-languages">
                        @foreach (var l in CommonLanguages)
                        {
                            <option value="@l"></option>
                        }
                    </datalist>
                    <span class="field-hint">Questions, answers, explanations and grading feedback are written in this language.</span>
                </label>
                <label class="field">
                    <span>Description <span class="muted" style="font-weight:400">(optional)</span></span>
                    <textarea class="textarea" rows="3" @bind="_description" @bind:event="oninput" maxlength="1000"></textarea>
                </label>
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="() => Resolve(null)">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_name))">@_okLabel</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    public sealed record TopicInput(string Name, string Language, string? Description);

    private static readonly string[] CommonLanguages =
    [
        "English", "German", "French", "Spanish", "Italian", "Portuguese", "Dutch", "Polish", "Swedish",
        "Danish", "Norwegian", "Finnish", "Czech", "Greek", "Turkish", "Russian", "Ukrainian",
        "Chinese", "Japanese", "Korean", "Arabic", "Hebrew", "Hindi",
    ];

    private bool _visible;
    private bool _focusPending;
    private string _title = "";
    private string _okLabel = "";
    private string _name = "";
    private string _language = "";
    private string? _description;
    private ElementReference _nameInput;
    private TaskCompletionSource<TopicInput?>? _tcs;

    public Task<TopicInput?> AskAsync(string title, string okLabel, TopicInput? initial = null)
    {
        _title = title;
        _okLabel = okLabel;
        _name = initial?.Name ?? "";
        _language = initial?.Language ?? "English";
        _description = initial?.Description;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<TopicInput?>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _nameInput.FocusAsync(); } catch (JSException) { }
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        Resolve(new TopicInput(_name.Trim(), string.IsNullOrWhiteSpace(_language) ? "English" : _language.Trim(), _description));
    }

    private void Resolve(TopicInput? result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}

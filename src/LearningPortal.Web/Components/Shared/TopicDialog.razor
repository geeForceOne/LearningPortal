@if (_visible)
{
    <div class="modal-backdrop">
        <div class="modal" role="dialog" aria-modal="true" aria-labelledby="topic-dialog-title">
            <h2 id="topic-dialog-title">@_title</h2>
            <form class="form" @onsubmit="Submit" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>Name</span>
                    <input class="input" @bind="_name" @bind:event="oninput" @ref="_nameInput" maxlength="200" placeholder="e.g. Cell biology" />
                </label>
                <div class="field">
                    <label class="field-label" for="topic-language">Language</label>
                    @* A plain list, not a datalist: a datalist only suggests what matches the text already in
                       the box, so with "English" filled in it hid every other language. *@
                    <select id="topic-language" class="select" value="@_languagePick" @onchange="PickLanguage">
                        @foreach (var l in LanguageChoices)
                        {
                            <option value="@l">@l</option>
                        }
                        <option value="@OtherLanguage">Other language...</option>
                    </select>
                    @if (_languagePick == OtherLanguage)
                    {
                        <input class="input" style="margin-top:8px" @bind="_language" @bind:event="oninput" maxlength="80"
                               placeholder="e.g. Latin" aria-label="Other language" />
                    }
                    <span class="field-hint">Questions, answers, explanations and grading feedback are written in this language.</span>
                </div>
                <div class="field">
                    <label class="check">
                        <input type="checkbox" @bind="_programming" />
                        Programming topic
                    </label>
                    <span class="field-hint">
                        Exams can then mix code questions (what does this print, find the bug) with theory, in a share
                        you choose per exam. Changing this affects newly generated questions; regenerate an exam to apply it.
                    </span>
                </div>
                <label class="field">
                    <span>Description <span class="muted" style="font-weight:400">(optional)</span></span>
                    <textarea class="textarea" rows="3" @bind="_description" @bind:event="oninput" maxlength="1000"></textarea>
                </label>
                <div class="modal-actions">
                    <button type="button" class="btn btn-ghost" @onclick="() => Resolve(null)">Cancel</button>
                    <button type="submit" class="btn btn-primary" disabled="@(string.IsNullOrWhiteSpace(_name))">@_okLabel</button>
                </div>
            </form>
        </div>
    </div>
}

@code {
    public sealed record TopicInput(string Name, string Language, string? Description, bool IsProgramming);

    private const string OtherLanguage = "__other";

    private static readonly string[] CommonLanguages =
    [
        "Arabic", "Chinese", "Czech", "Danish", "Dutch", "English", "Finnish", "French", "German", "Greek",
        "Hebrew", "Hindi", "Hungarian", "Indonesian", "Italian", "Japanese", "Korean", "Norwegian", "Polish",
        "Portuguese", "Romanian", "Russian", "Spanish", "Swedish", "Turkish", "Ukrainian", "Vietnamese",
    ];

    // The common languages, plus a topic's own language when it isn't one of them (set earlier by
    // typing), so editing the topic shows it rather than "Other".
    private string[] LanguageChoices => _saved is { } saved && !IsCommon(saved)
        ? [.. CommonLanguages, saved]
        : CommonLanguages;

    private string _languagePick = "English";
    private string? _saved;

    private bool _visible;
    private bool _focusPending;
    private string _title = "";
    private string _okLabel = "";
    private string _name = "";
    private string _language = "";
    private string? _description;
    private bool _programming;
    private ElementReference _nameInput;
    private TaskCompletionSource<TopicInput?>? _tcs;

    public Task<TopicInput?> AskAsync(string title, string okLabel, TopicInput? initial = null)
    {
        _title = title;
        _okLabel = okLabel;
        _name = initial?.Name ?? "";
        _language = initial?.Language ?? "English";
        _saved = initial?.Language;
        _languagePick = CommonLanguages.FirstOrDefault(l => l.Equals(_language, StringComparison.OrdinalIgnoreCase)) ?? _language;
        _description = initial?.Description;
        _programming = initial?.IsProgramming ?? false;
        _visible = true;
        _focusPending = true;
        _tcs = new TaskCompletionSource<TopicInput?>();
        StateHasChanged();
        return _tcs.Task;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_focusPending) return;
        _focusPending = false;
        try { await _nameInput.FocusAsync(); } catch (JSException) { }
    }

    private static bool IsCommon(string language) => CommonLanguages.Any(l => l.Equals(language, StringComparison.OrdinalIgnoreCase));

    private void PickLanguage(ChangeEventArgs e)
    {
        _languagePick = e.Value?.ToString() ?? "English";
        _language = _languagePick == OtherLanguage ? "" : _languagePick;
    }

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(_name)) return;
        Resolve(new TopicInput(_name.Trim(), string.IsNullOrWhiteSpace(_language) ? "English" : _language.Trim(), _description, _programming));
    }

    private void Resolve(TopicInput? result)
    {
        _visible = false;
        var tcs = _tcs;
        _tcs = null;
        StateHasChanged();
        tcs?.TrySetResult(result);
    }
}

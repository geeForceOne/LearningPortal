@using LearningPortal.Core.Security
@* A secret input (API key, password) that never shows the stored value: it only says whether one is saved.
   The eye button only reveals what's typed into the box, which never left the browser. *@
<div class="field">
    <label class="field-label" for="@_id">@Label</label>

    @if (Removing)
    {
        <div class="notice notice-warn">The saved @Noun will be removed when you save.</div>
    }
    else if (Status == SecretStatus.Set)
    {
        <div class="notice notice-good" style="display:flex;align-items:center;gap:10px;flex-wrap:wrap">
            <span style="flex:1">A @Noun is saved@(SavedExpiresOn is { } saved ? $", expiring {Format.Day(saved)}" : ""). Type a new one below to replace it.</span>
            <button type="button" class="btn btn-ghost btn-sm" @onclick="OnRemove">Remove @Noun</button>
        </div>
    }
    else if (Status == SecretStatus.Unreadable)
    {
        <div class="notice notice-error">
            Your saved @Noun can't be read anymore, usually because the server's encryption keys were
            reset. Enter it again below.
        </div>
    }

    @* Browsers ignore autocomplete="off" on password inputs and fill in the saved Recall login.
       "new-password" stops that, and the data-* attributes tell 1Password, LastPass and Bitwarden
       to leave the field alone. *@
    <div class="input-with-action">
        <input id="@_id" class="input" type="@(_reveal ? "text" : "password")" autocomplete="new-password" spellcheck="false"
               data-1p-ignore data-lpignore="true" data-bwignore="true" data-form-type="other"
               value="@Value" @oninput="e => ValueChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty)"
               placeholder="@(Status == SecretStatus.Set ? $"Leave empty to keep the saved {Noun}" : Placeholder)" />
        <button type="button" class="btn btn-ghost btn-icon btn-sm" @onclick="() => _reveal = !_reveal"
                title="@(_reveal ? $"Hide the {Noun}" : $"Show the {Noun} you typed")" aria-label="@(_reveal ? $"Hide the {Noun}" : $"Show the {Noun} you typed")"
                aria-pressed="@(_reveal ? "true" : "false")" aria-controls="@_id">
            <Icon Name="@(_reveal ? "eye-off" : "eye")" Size="16" />
        </button>
    </div>
    <span class="field-hint">@Hint It's stored encrypted and never shown again.</span>

    @if (ShowExpiry)
    {
        <div class="key-expiry">
            <label class="field-label" for="@(_id)-expires">Expires on <span class="muted" style="font-weight:400">(optional)</span></label>
            <input id="@(_id)-expires" class="input" type="date" value="@ExpiresOn?.ToString("yyyy-MM-dd")"
                   @onchange="e => ExpiresOnChanged.InvokeAsync(DateOnly.TryParse(e.Value?.ToString(), out var d) ? d : null)" />
            <span class="field-hint">The expiry date you chose when creating the key. @AppInfo.Name reminds you @SettingsService.ReminderDays days before.</span>
        </div>
    }
</div>

@code {
    private readonly string _id = "key-" + Guid.NewGuid().ToString("N")[..8];
    private bool _reveal;

    [Parameter, EditorRequired] public string Label { get; set; } = "";
    [Parameter] public SecretStatus Status { get; set; }
    [Parameter] public string Value { get; set; } = "";
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public EventCallback OnRemove { get; set; }
    [Parameter] public bool Removing { get; set; }
    [Parameter] public RenderFragment? Hint { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    // What the secret is called in the messages: "key", "password".
    [Parameter] public string Noun { get; set; } = "key";

    // API keys only: an optional expiry date, edited with the key and saved with it.
    [Parameter] public bool ShowExpiry { get; set; }
    [Parameter] public DateOnly? ExpiresOn { get; set; }
    [Parameter] public EventCallback<DateOnly?> ExpiresOnChanged { get; set; }
    [Parameter] public DateOnly? SavedExpiresOn { get; set; }
}

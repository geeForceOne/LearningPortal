@* Status line for a long-running AI operation, with a way out. Large (while the AI writes
   questions, which takes minutes) shows the larger, detailed logo; Note adds a second line. *@
@if (Message is not null)
{
    <div class="busy" role="status" aria-live="polite">
        <BrandMark Size="@(Large ? 48 : 22)" Busy="true" />
        <span class="busy-text">
            @Message
            @if (Note is not null)
            {
                <span class="busy-note">@Note</span>
            }
        </span>
        @if (OnCancel.HasDelegate)
        {
            <button type="button" class="btn btn-ghost btn-sm" @onclick="OnCancel">Cancel</button>
        }
    </div>
}

@code {
    [Parameter] public string? Message { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public string? Note { get; set; }
    [Parameter] public bool Large { get; set; }
}

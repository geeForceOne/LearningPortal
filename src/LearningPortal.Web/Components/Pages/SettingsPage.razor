@page "/settings"
@inherits AppPage
@inject SettingsService Settings
@inject IJSRuntime JS
@using LearningPortal.Core.Security

<PageTitle>Settings - @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>Settings</h1>
        <p class="page-sub">
            How Recall looks, your AI keys, and which models outline your material, write your exams and grade them. You use
            your own API keys: requests are billed to your account with each provider.
        </p>
    </div>
</div>

@if (_view is null)
{
    <p class="page-loading">Loading...</p>
}
else
{
    <div class="settings settings-stacked">
        <section class="setting">
            <div class="setting-intro">
                <h2>Appearance</h2>
                <p>How Recall looks. Saved with your account, so it follows you to other devices.</p>
            </div>
            <div class="setting-body">
                <div class="field">
                    <span class="field-label" id="theme-label">Theme</span>
                    <div class="segmented" role="radiogroup" aria-labelledby="theme-label">
                        @foreach (var theme in Enum.GetValues<Theme>())
                        {
                            <label><input type="radio" name="theme" checked="@(_theme == theme)" @onchange="() => SetThemeAsync(theme)" /> @theme</label>
                        }
                    </div>
                    <span class="field-hint">
                        @(_theme == Theme.System ? "Follows your device's light or dark setting." : "Saved as soon as you pick it.")
                    </span>
                </div>
            </div>
        </section>

        <section class="setting">
            <div class="setting-intro">
                <h2>API keys</h2>
                <p>Your own key for Claude, OpenAI or both. Requests are billed to your account with that provider.</p>
            </div>
            <div class="setting-body">
                <div class="notice notice-warn" role="note">
                    <strong>@AppInfo.KeySafetyTitle</strong>
                    <p class="key-safety">@AppInfo.KeySafety</p>
                    <p class="key-safety">
                        For Claude: set a monthly spend limit under Settings &rsaquo; Billing &rsaquo; Spend limits in the Claude Console, and choose an
                        expiration when you <a href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener noreferrer">create the key</a>.
                    </p>
                    <p class="key-safety">
                        For OpenAI: set a monthly spend limit, enforced as a hard limit, under Limits in your organization or project
                        settings, and choose an expiration when you <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer">create the key</a>.
                    </p>
                </div>

                <KeyField Label="Anthropic API key (Claude)" Status="_view.ClaudeKey" Value="@_claudeKey" ValueChanged="v => KeyTyped(AiProvider.Claude, v)"
                          OnRemove="() => Remove(AiProvider.Claude)" Removing="_removeClaude" Placeholder="sk-ant-..."
                          ShowExpiry="HasKeyAfterSave(AiProvider.Claude)" @bind-ExpiresOn="_claudeExpires" SavedExpiresOn="_view.ClaudeKeyExpiresOn">
                    <Hint>
                        Create one at <a href="https://platform.claude.com/settings/keys" target="_blank" rel="noopener noreferrer">platform.claude.com</a> under API keys.
                        New to API keys? <a href="@AppInfo.ClaudeKeyGuideUrl" target="_blank" rel="noopener noreferrer">Step-by-step guide</a>.
                    </Hint>
                </KeyField>
                <KeyField Label="OpenAI API key (ChatGPT)" Status="_view.OpenAiKey" Value="@_openAiKey" ValueChanged="v => KeyTyped(AiProvider.OpenAi, v)"
                          OnRemove="() => Remove(AiProvider.OpenAi)" Removing="_removeOpenAi" Placeholder="sk-..."
                          ShowExpiry="HasKeyAfterSave(AiProvider.OpenAi)" @bind-ExpiresOn="_openAiExpires" SavedExpiresOn="_view.OpenAiKeyExpiresOn">
                    <Hint>
                        Create one at <a href="https://platform.openai.com/api-keys" target="_blank" rel="noopener noreferrer">platform.openai.com</a> under API keys.
                        New to API keys? <a href="@AppInfo.OpenAiKeyGuideUrl" target="_blank" rel="noopener noreferrer">Step-by-step guide</a>.
                    </Hint>
                </KeyField>

                <div class="actions">
                    <button type="button" class="btn btn-primary" disabled="@(_savingKeys || !KeysChanged)" @onclick="SaveKeysAsync">Save API keys</button>
                </div>
            </div>
        </section>

        <section class="setting">
            <div class="setting-intro">
                <h2>Models</h2>
                <p>Which AI model outlines your material, writes your questions and grades your answers.</p>
            </div>
            <div class="setting-body">
                <div class="field">
                    <span class="field-label" id="mode-label">Mode</span>
                    <div class="segmented" role="radiogroup" aria-labelledby="mode-label">
                        <label><input type="radio" name="model-mode" checked="@(!_advanced)" @onchange="() => _advanced = false" /> Simple</label>
                        <label><input type="radio" name="model-mode" checked="@_advanced" @onchange="() => _advanced = true" /> Advanced</label>
                    </div>
                    <span class="field-hint">
                        @(_advanced
                            ? "Separate models for outlining uploads and for questions. You can pick another model each time you upload or generate."
                            : "One model for everything.")
                    </span>
                </div>

                @if (_advanced)
                {
                    <AiModelSelect Label="Uploads (outline)" @bind-Value="_analysis" Available="Available" AllowCustom="true">
                        <Hint><span class="field-hint">Reads each file you add once to outline it. A cheaper model is usually enough.</span></Hint>
                    </AiModelSelect>
                    <AiModelSelect Label="Questions & grading" @bind-Value="_generation" Available="Available" AllowCustom="true">
                        <Hint><span class="field-hint">Writes and replaces questions, and grades written answers.</span></Hint>
                    </AiModelSelect>
                }
                else
                {
                    <AiModelSelect Label="Model" @bind-Value="_simple" Available="Available" AllowCustom="true">
                        <Hint><span class="field-hint">Outlines your uploads, writes questions and grades written answers.</span></Hint>
                    </AiModelSelect>
                }

                <span class="field-hint">
                    Prices are per million input / output tokens, as of @AiModels.PricesAsOf. Current prices:
                    <a href="@AiModels.ClaudePricingUrl" target="_blank" rel="noopener noreferrer">Claude</a>,
                    <a href="@AiModels.OpenAiPricingUrl" target="_blank" rel="noopener noreferrer">OpenAI</a>.
                </span>

                <div class="actions">
                    <button type="button" class="btn btn-primary" disabled="@_savingModels" @onclick="SaveModelsAsync">Save models</button>
                </div>
            </div>
        </section>
    </div>
}

@code {
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private SettingsView? _view;
    private bool _advanced;
    private AiChoice _simple = default!;
    private AiChoice _analysis = default!;
    private AiChoice _generation = default!;
    private string _claudeKey = "";
    private string _openAiKey = "";
    private bool _removeClaude;
    private bool _removeOpenAi;
    private DateOnly? _claudeExpires;
    private DateOnly? _openAiExpires;
    private bool _savingKeys;
    private bool _savingModels;
    private Theme _theme;

    protected override async Task OnInitializedAsync()
    {
        _theme = await Settings.GetThemeAsync(await UserIdAsync(), PageToken);
        await LoadViewAsync();
        _advanced = _view!.AdvancedModels;
        _simple = _view.Simple;
        _analysis = _view.Analysis;
        _generation = _view.Generation;
    }

    private async Task SetThemeAsync(Theme theme)
    {
        _theme = theme;
        await JS.InvokeVoidAsync("lpApplyTheme", theme.ToString().ToLowerInvariant());
        await Settings.SetThemeAsync(await UserIdAsync(), theme, PageToken);
    }

    // Reloads the key status and clears the key boxes; the Models panel keeps what's on screen.
    private async Task LoadViewAsync()
    {
        _view = await Settings.GetAsync(await UserIdAsync(), PageToken);
        _claudeExpires = _view.ClaudeKeyExpiresOn;
        _openAiExpires = _view.OpenAiKeyExpiresOn;
        _claudeKey = "";
        _openAiKey = "";
        _removeClaude = false;
        _removeOpenAi = false;
    }

    // Only saved keys count: a key typed but not saved yet doesn't unlock its models.
    private bool Available(AiProvider provider) => _view!.HasKey(provider);

    private bool KeysChanged =>
        _removeClaude || _removeOpenAi || !string.IsNullOrWhiteSpace(_claudeKey) || !string.IsNullOrWhiteSpace(_openAiKey)
        || _claudeExpires != _view!.ClaudeKeyExpiresOn || _openAiExpires != _view.OpenAiKeyExpiresOn;

    // The expiry date belongs to a key, so it's offered while one is saved (and not being removed)
    // or being typed in.
    private bool HasKeyAfterSave(AiProvider provider) => provider == AiProvider.Claude
        ? !string.IsNullOrWhiteSpace(_claudeKey) || (!_removeClaude && _view!.HasKey(AiProvider.Claude))
        : !string.IsNullOrWhiteSpace(_openAiKey) || (!_removeOpenAi && _view!.HasKey(AiProvider.OpenAi));

    private void KeyTyped(AiProvider provider, string value)
    {
        // A new key has its own expiry date, so starting to type one clears the old date.
        if (provider == AiProvider.Claude)
        {
            if (string.IsNullOrWhiteSpace(_claudeKey) && !string.IsNullOrWhiteSpace(value)) _claudeExpires = null;
            _claudeKey = value;
            _removeClaude = false;
        }
        else
        {
            if (string.IsNullOrWhiteSpace(_openAiKey) && !string.IsNullOrWhiteSpace(value)) _openAiExpires = null;
            _openAiKey = value;
            _removeOpenAi = false;
        }
    }

    private void Remove(AiProvider provider)
    {
        if (provider == AiProvider.Claude) { _removeClaude = true; _claudeKey = ""; _claudeExpires = null; }
        else { _removeOpenAi = true; _openAiKey = ""; _openAiExpires = null; }
    }

    // A choice whose provider has no key switches to the other provider's default when that one has
    // a key, so someone with only an OpenAI key doesn't have to fix every dropdown by hand.
    // Returns whether anything changed.
    private bool MoveOffUnavailable()
    {
        AiChoice Fix(AiChoice c)
        {
            var other = c.Provider == AiProvider.Claude ? AiProvider.OpenAi : AiProvider.Claude;
            return !Available(c.Provider) && Available(other) ? new AiChoice(other, AiModels.DefaultFor(other)) : c;
        }
        var before = (_simple, _analysis, _generation);
        _simple = Fix(_simple);
        _analysis = Fix(_analysis);
        _generation = Fix(_generation);
        return (_simple, _analysis, _generation) != before;
    }

    private async Task SaveKeysAsync()
    {
        _savingKeys = true;
        try
        {
            // A typed key replaces the stored one; an empty box leaves it alone; "Remove" clears it.
            await Settings.SaveKeysAsync(await UserIdAsync(),
                _removeClaude ? "" : string.IsNullOrWhiteSpace(_claudeKey) ? null : _claudeKey,
                _removeOpenAi ? "" : string.IsNullOrWhiteSpace(_openAiKey) ? null : _openAiKey,
                _claudeExpires, _openAiExpires, PageToken);
            await LoadViewAsync();

            // The saved models only change when the user saves them, so a switch here needs a save.
            if (MoveOffUnavailable())
                Ui.Toast.Success("API keys saved. Models switched to a provider you have a key for: click Save models to keep it.");
            else
                Ui.Toast.Success("API keys saved.");
        }
        finally
        {
            _savingKeys = false;
        }
    }

    private async Task SaveModelsAsync()
    {
        _savingModels = true;
        try
        {
            await Settings.SaveModelsAsync(await UserIdAsync(), new ModelsUpdate(_advanced, _simple, _analysis, _generation), PageToken);

            var inUse = _advanced ? new[] { _analysis, _generation } : [_simple];
            if (inUse.FirstOrDefault(c => !Available(c.Provider)) is { } missing)
                Ui.Toast.Error($"Models saved, but there's no {AiModels.ProviderName(missing.Provider)} API key for the model you picked.");
            else
                Ui.Toast.Success("Models saved.");
        }
        finally
        {
            _savingModels = false;
        }
    }
}

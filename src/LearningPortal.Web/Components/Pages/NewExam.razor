@page "/topics/{TopicId:int}/exams/new"
@inherits AppPage
@inject TopicService Topics
@inject ExamService Exams
@inject QuestionGenerationService Generator
@inject SettingsService Settings
@inject LearningPortalOptions Options

<PageTitle>New exam - @AppInfo.Name</PageTitle>

@if (_topic is null)
{
    <p class="page-loading">Loading...</p>
}
else
{
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="">Topics</a><span class="sep">/</span><a href="topics/@TopicId">@_topic.Summary.Name</a>
    </nav>
    <div class="page-head">
        <div>
            <h1>New exam</h1>
            <p class="page-sub">
                Up to the share you choose below comes from this topic's question bank; the AI writes the
                rest, in @_topic.Summary.Language.
            </p>
        </div>
    </div>

    <div class="form-narrow">
        <ExamSettingsForm Model="_values" BankCounts="_bank" Programming="_topic.Summary.IsProgramming" Materials="_materials" OnChanged="OnChangedAsync" />

        @if (_settings is { AdvancedModels: true })
        {
            <div style="margin-top:22px">
                <AiModelSelect Label="Write with" @bind-Value="_writeWith" Available="_settings.HasKey" Inline="true" />
            </div>
        }

        <div class="actions" style="margin-top:28px">
            <button type="button" class="btn btn-primary btn-lg" disabled="@(IsBusy || !IsValid)" @onclick="CreateAsync">Create exam</button>
            <a class="btn btn-ghost btn-lg" href="topics/@TopicId">Cancel</a>
        </div>
        @if (IsValid && Basis is not null && Format.CostHint(Generator.Estimate(Basis, ToGenerate())) is { } hint)
        {
            <p class="muted small" style="margin-top:8px">The AI writes @Format.Plural(ToGenerate(), "new question", "new questions"): @hint.</p>
        }
        <SaturationNotice Basis="Basis" Show="@(ToGenerate() > 0)" Style="margin-top:14px" />

        @if (IsBusy)
        {
            <div style="margin-top:20px"><BusyBar Message="@BusyMessage" OnCancel="CancelBusy" KeepOpen="BusyKeepsPageOpen" /></div>
            <p class="muted small" style="margin-top:8px">Writing questions can take a minute or two. Questions finished so far are kept even if you cancel.</p>
        }
        @if (_error is not null)
        {
            <div class="notice notice-error" style="margin-top:20px">@_error</div>
        }
    </div>
}

@code {
    [Parameter] public int TopicId { get; set; }
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private TopicDetail? _topic;
    private Dictionary<(QuestionType Type, Difficulty Difficulty, bool IsCode), int>? _bank;
    private readonly ExamSettingsForm.Values _values = new();
    private string? _error;
    private GenerationCostBasis? _cost;
    private IReadOnlyList<MaterialChoice> _materials = [];
    private SettingsView? _settings;
    // The model that writes the questions; starts at the questions default.
    private AiChoice _writeWith = default!;
    // The documents _bank and _cost were loaded for, to reload them when the selection changes.
    private string _loadedFor = "";

    // The cost basis priced for the model picked here.
    private GenerationCostBasis? Basis => _cost is null ? null : _cost with { Model = AiModels.Find(_writeWith) };

    // Passed to generation only in advanced mode; in simple mode the one model does everything.
    private AiChoice? Choice => _settings?.AdvancedModels == true ? _writeWith : null;

    private bool IsValid => !string.IsNullOrWhiteSpace(_values.Name) && _values.QuestionCount is >= 1 and <= ExamService.MaxQuestions;

    protected override async Task OnInitializedAsync()
    {
        var userId = await UserIdAsync();
        try
        {
            _topic = await Topics.GetAsync(userId, TopicId, PageToken);
        }
        catch (NotFoundException)
        {
            Nav.NavigateTo("not-found");
            return;
        }
        _materials = await Topics.MaterialChoicesAsync(userId, TopicId, PageToken);
        _settings = await Settings.GetAsync(userId, PageToken);
        _writeWith = _settings.Default(AiTask.Generation);
        await LoadBankAndCostAsync(userId);
        _values.Name = $"{_topic.Summary.Name} practice {_topic.Exams.Count + 1}";
    }

    // The bank questions and material an exam could use depend on its documents.
    private async Task LoadBankAndCostAsync(string userId)
    {
        _loadedFor = string.Join(",", _values.Excluded.Order());
        _bank = await Topics.BankCountsAsync(userId, TopicId, _values.Excluded, PageToken);
        _cost = await Generator.CostBasisAsync(userId, TopicId, _values.Excluded, ct: PageToken);
    }

    private async Task OnChangedAsync()
    {
        if (_loadedFor != string.Join(",", _values.Excluded.Order()))
            await LoadBankAndCostAsync(await UserIdAsync());
    }

    // Questions the AI still has to write: the requested count minus what the bank can supply.
    private int ToGenerate() => ExamService.Plan(_values.ToSettings(), _bank!, _topic!.Summary.IsProgramming).Generated;

    private async Task CreateAsync()
    {
        _error = null;
        var userId = await UserIdAsync();

        // Guardrail: users pay with their own keys, so a generation that sends a lot of material
        // is confirmed first.
        var estimate = await Generator.EstimateAsync(userId, TopicId, ToGenerate(), _values.Excluded, _writeWith, PageToken);
        if (Options.IsLargeGeneration(estimate.TotalInputTokens, estimate.Model) &&
            !await Ui.Confirm.AskAsync("This is a large generation",
                Format.LargeGeneration(estimate),
                "Generate questions"))
            return;

        int? examId = null;
        FillResult? result = null;
        await RunBusyAsync("Creating the exam...", async (progress, ct) =>
        {
            examId = await Exams.CreateAsync(userId, TopicId, _values.ToSettings(), ct);
            result = await Exams.FillAsync(userId, examId.Value, Choice, progress, ct);
        }, message => _error = message, keepPageOpen: true);

        if (examId is null)
            return;

        if (result is { Missing: > 0 })
            Ui.Toast.Error($"The exam has {Format.Plural(result.Missing, "question", "questions")} fewer than asked. You can top it up from the exam page.");
        else if (_error is not null)
            Ui.Toast.Error(_error);

        Nav.NavigateTo($"exams/{examId}");
    }
}

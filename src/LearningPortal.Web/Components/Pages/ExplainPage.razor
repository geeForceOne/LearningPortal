@page "/topics/{TopicId:int}/explain"
@inherits AppPage
@inject TopicService Topics
@inject ExplainService Explain
@inject SettingsService Settings
@inject AnalysisQueue Analysis
@inject LearningPortalOptions Options

<PageTitle>Explain it back - @AppInfo.Name</PageTitle>

@if (_notFound)
{
    <div class="empty"><p>That topic doesn't exist or isn't yours.</p><a class="btn btn-secondary" href="">Go to your topics</a></div>
}
else if (_topic is null || _concepts is null)
{
    <p class="page-loading">Loading...</p>
}
else
{
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="">Topics</a><span class="sep">/</span>
        <a href="topics/@TopicId">@_topic.Summary.Name</a>
    </nav>
    <div class="page-head">
        <div>
            <h1>Explain it back</h1>
            <p class="page-sub">
                Pick a concept from your material and explain it in your own words, as if to someone new to the subject.
                Recall asks one or two questions like a curious student, then tells you what you explained well and what was missing.
            </p>
        </div>
        @if (_concepts.Count > 0)
        {
            <button type="button" class="btn btn-primary" disabled="@_starting" @onclick="SurpriseAsync"><Icon Name="play" Size="16" /> Surprise me</button>
        }
    </div>

    @if (_concepts.Count == 0)
    {
        <div class="empty"><p>Add material to this topic first. Its concepts show up here once it's been outlined.</p></div>
    }
    else
    {
        <p class="muted small">"Surprise me" favors the parts of your material you do worst on or haven't practiced yet.</p>
    }

    @* Material analyzed before Recall listed the concepts itself: they're split from its outline. *@
    @if (_older is { Count: > 0 } && _older.Any(m => Analysis.IsPending(m.MaterialId)))
    {
        @* The analysis runs in the background queue and can't be stopped, so there's no Cancel. *@
        <div style="margin-bottom:20px">
            <BusyBar Message="Recall is analyzing your material again..."
                     Note="The concepts update here when it's done. You can leave this page." />
        </div>
    }
    else if (_older is { Count: > 0 })
    {
        <div class="notice" style="margin-bottom:20px">
            <span>@OlderText() come from an older outline, so some can read oddly.</span>
            <button type="button" class="link-button" @onclick="AnalyzeAgainAsync">@(_older.Count == 1 ? "Analyze it again" : "Analyze them again")</button>
            <span>to have Recall list them properly@(AnalyzeCost() is { } cost ? $" ({cost})" : "").</span>
            @if (_older.FirstOrDefault(m => m.Error is not null) is { } failed)
            {
                <div style="margin-top:6px;color:var(--wrong)">The last try failed: @failed.Error</div>
            }
            @if (_settings is { AdvancedModels: true })
            {
                <div style="margin-top:10px;max-width:520px">
                    <AiModelSelect Label="Outline with" Value="_outlineWith" ValueChanged="SetOutlineModel" Available="_settings.HasKey" AllowedModels="_settings.AllowedModels" Inline="true" />
                </div>
            }
        </div>
    }

    @if (_concepts.Count > 0)
    {
        @foreach (var group in _concepts.GroupBy(c => c.MaterialTitle))
        {
            <section class="section" @key="group.Key">
                <div class="section-head"><h2>@group.Key</h2></div>
                <ul class="rows">
                    @foreach (var s in group.GroupBy(c => c.SectionId))
                    {
                        var first = s.First();
                        <li class="row" @key="s.Key">
                            <div class="row-main">
                                @* A section whose only concept is its own name needs no heading. *@
                                @if (s.Count() > 1 || first.Label != first.SectionName)
                                {
                                    <div class="concept-section">@first.SectionName</div>
                                }
                                <ul class="concept-list">
                                    @foreach (var c in s)
                                    {
                                        var concept = c;
                                        <li @key="concept.Label">
                                            <button type="button" class="link-button concept-pick" disabled="@_starting" @onclick="() => StartAsync(concept)">@concept.Label</button>
                                            @if (concept.Task is not null)
                                            {
                                                <div class="concept-task">@concept.Task</div>
                                            }
                                        </li>
                                    }
                                </ul>
                            </div>
                            <div class="row-aside"><span class="map-swatch is-@first.State" title="@StateLabel(first.State)"></span> <span class="small muted">@StateLabel(first.State)</span></div>
                        </li>
                    }
                </ul>
            </section>
        }
    }

    @if (_history is { Count: > 0 })
    {
        <section class="section">
            <div class="section-head"><h2>Your explanations<span class="count">@_history.Count</span></h2></div>
            <ul class="rows">
                @foreach (var h in _history)
                {
                    <li class="row" @key="h.Id">
                        <div class="row-main">
                            <a class="row-title" href="explain/@h.Id">@h.Concept</a>
                            <div class="row-meta"><span>@Format.Date(h.CreatedAt)</span></div>
                        </div>
                        <div class="row-aside">
                            @if (h.Score is { } score)
                            {
                                <VerdictLabel Score="score" ShowScore="true" />
                            }
                            else
                            {
                                <span class="muted small">Not finished</span>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    [Parameter] public int TopicId { get; set; }
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private TopicDetail? _topic;
    private IReadOnlyList<ExplainConcept>? _concepts;
    private IReadOnlyList<ExplainSummary>? _history;
    private IReadOnlyList<ConceptRefresh>? _older;
    private SettingsView? _settings;
    // The model that analyzes material again from here; starts at the uploads default.
    private AiChoice _outlineWith = default!;
    private AiModelInfo? _model;

    // Passed to the analysis only in advanced mode; in simple mode the one model does everything.
    private AiChoice? Choice => _settings?.AdvancedModels == true ? _outlineWith : null;
    private bool _starting;
    private bool _notFound;

    protected override async Task OnParametersSetAsync()
    {
        Analysis.MaterialAnalyzed -= OnMaterialAnalyzed;
        Analysis.MaterialAnalyzed += OnMaterialAnalyzed;
        try
        {
            var userId = await UserIdAsync();
            _topic = await Topics.GetAsync(userId, TopicId, PageToken);
            _history = await Explain.ListAsync(userId, TopicId, PageToken);
            if (_settings is null)
            {
                _settings = await Settings.GetAsync(userId, PageToken);
                SetOutlineModel(_settings.Default(AiTask.Analysis));
            }
            await LoadConceptsAsync(userId);
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task LoadConceptsAsync(string userId)
    {
        _concepts = await Explain.GetConceptsAsync(userId, TopicId, PageToken);
        _older = await Explain.WithoutConceptListsAsync(userId, TopicId, PageToken);
    }

    private void OnMaterialAnalyzed(string userId, int materialId)
    {
        if (_older?.Any(m => m.MaterialId == materialId) != true)
            return;
        _ = InvokeAsync(async () =>
        {
            await LoadConceptsAsync(userId);
            StateHasChanged();
        });
    }

    public override void Dispose()
    {
        Analysis.MaterialAnalyzed -= OnMaterialAnalyzed;
        base.Dispose();
    }

    private void SetOutlineModel(AiChoice choice)
    {
        _outlineWith = choice;
        _model = AiModels.Find(choice);
    }

    private string OlderText() => _older!.Count == 1
        ? $"The concepts for \"{_older[0].Title}\""
        : $"The concepts for {_older.Count} of your materials";

    // Mentioned only when it's worth noticing; a few cents isn't.
    private string? AnalyzeCost() => Format.CostHint(_older!.Sum(m => m.TokenEstimate), _model);

    // Sends the material to the AI again, billed to the user's key, so a large one is confirmed first.
    private async Task AnalyzeAgainAsync()
    {
        var older = _older!;
        var tokens = older.Sum(m => m.TokenEstimate);
        if (Options.IsLargeGeneration(tokens, _model))
        {
            var cost = Format.AnalysisCost(tokens, _model);
            var go = await Ui.Confirm.AskAsync("This is a lot of material to analyze",
                $"It's about {Format.Tokens(tokens)}. The AI reads all of it once more" +
                (cost is null ? "" : $", {cost}") + $". {Format.BilledTo(_settings)} Analyze it again?",
                "Analyze again");
            if (!go)
                return;
        }

        var userId = await UserIdAsync();
        foreach (var material in older)
            Analysis.Enqueue(userId, material.MaterialId, Choice);
    }

    private async Task SurpriseAsync()
    {
        if (await Explain.SurpriseAsync(await UserIdAsync(), TopicId, PageToken) is { } concept)
            await StartAsync(concept);
    }

    private async Task StartAsync(ExplainConcept concept)
    {
        _starting = true;
        try
        {
            var id = await Explain.StartAsync(await UserIdAsync(), TopicId, concept.SectionId, concept.Label, PageToken);
            Nav.NavigateTo($"explain/{id}");
        }
        catch (NotFoundException ex)
        {
            Ui.Toast.Error(ex.Message);
            _starting = false;
        }
    }

    private static string StateLabel(string state) => state switch
    {
        "solid" => "Solid",
        "shaky" => "Shaky",
        "weak" => "Weak",
        "new" => "Not practiced yet",
        _ => "No questions yet",
    };
}

@page "/topics/{TopicId:int}/gaps"
@inherits AppPage
@inject TopicService Topics
@inject GapService Gaps
@inject AnalysisQueue Analysis
@inject SettingsService Settings

<PageTitle>Find gaps - @AppInfo.Name</PageTitle>

@if (_notFound)
{
    <div class="empty"><p>That topic doesn't exist or isn't yours.</p><a class="btn btn-secondary" href="">Go to your topics</a></div>
}
else if (_topic is null)
{
    <p class="page-loading">Loading...</p>
}
else
{
    <nav class="crumbs" aria-label="Breadcrumb">
        <a href="">Topics</a><span class="sep">/</span>
        <a href="topics/@TopicId">@_topic.Summary.Name</a>
    </nav>
    <div class="page-head">
        <div>
            <h1>Find gaps</h1>
            <p class="page-sub">
                Recall compares your material with what a course on this topic usually covers and lists what's missing.
                For each gap it can write a short study note, added to the topic as material.
            </p>
        </div>
    </div>

    <div class="notice notice-warn" role="note" style="margin-bottom:20px">
        <strong>This comes from the AI's general knowledge, not from your material.</strong>
        It can be wrong, miss things, or suggest gaps your course doesn't need. Study notes it writes are marked
        "Written by the AI" and may contain mistakes: check them against a trusted source.
    </div>

    @if (_topic.Materials.Count == 0)
    {
        <div class="empty"><p>Add material to this topic first.</p></div>
    }
    else
    {
        @if (_settings is { AdvancedModels: true })
        {
            <div style="margin-bottom:14px;max-width:520px">
                <AiModelSelect Label="Write with" @bind-Value="_writeWith" Available="_settings.HasKey" Inline="true">
                    <Hint><span class="field-hint">Used for finding gaps and for the study notes.</span></Hint>
                </AiModelSelect>
            </div>
        }
        <div class="actions">
            <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="FindAsync">
                <Icon Name="book" Size="16" /> @(_gaps is null ? "Find gaps" : "Look again")
            </button>
        </div>
    }

    @if (_error is not null)
    {
        <div class="notice notice-error" style="margin-top:16px">@_error</div>
    }
    @if (IsBusy)
    {
        <div style="margin-top:16px"><BusyBar Message="@BusyMessage" /></div>
    }

    @if (_gaps is { Count: 0 })
    {
        <div class="empty" style="margin-top:20px"><p>Recall didn't find any important gaps in your material.</p></div>
    }
    else if (_gaps is not null)
    {
        <section class="section" style="margin-top:28px">
            <div class="section-head"><h2>Possible gaps<span class="count">@_gaps.Count</span></h2></div>
            <ul class="rows">
                @foreach (var g in _gaps)
                {
                    var gap = g;
                    <li class="row" @key="gap.Title">
                        <div class="row-main">
                            <span class="row-title">@gap.Title</span>
                            <p class="muted small" style="margin:4px 0 0">@gap.Why</p>
                        </div>
                        <div class="row-actions">
                            @if (_written.TryGetValue(gap.Title, out var materialId))
                            {
                                <a class="btn btn-ghost btn-sm" href="materials/@materialId"><Icon Name="check" Size="14" /> Note added</a>
                            }
                            else
                            {
                                <button type="button" class="btn btn-secondary btn-sm" disabled="@IsBusy" @onclick="() => WriteNoteAsync(gap)">
                                    <Icon Name="text" Size="14" /> Write a study note
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </section>
    }
}

@code {
    [Parameter] public int TopicId { get; set; }
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private TopicDetail? _topic;
    private IReadOnlyList<Gap>? _gaps;
    private readonly Dictionary<string, int> _written = [];
    private string? _error;
    private bool _notFound;
    private SettingsView? _settings;
    private AiChoice _writeWith = default!;

    // Passed only in advanced mode; in simple mode the one model does everything.
    private AiChoice? Choice => _settings?.AdvancedModels == true ? _writeWith : null;

    protected override async Task OnParametersSetAsync()
    {
        try
        {
            var userId = await UserIdAsync();
            _topic = await Topics.GetAsync(userId, TopicId, PageToken);
            if (_settings is null)
            {
                _settings = await Settings.GetAsync(userId, PageToken);
                _writeWith = _settings.Default(AiTask.Generation);
            }
        }
        catch (NotFoundException)
        {
            _notFound = true;
        }
    }

    private async Task FindAsync()
    {
        _error = null;
        var userId = await UserIdAsync();
        IReadOnlyList<Gap>? found = null;
        if (await RunBusyAsync("Recall is comparing your material with the subject...", async (_, ct) =>
                found = await Gaps.FindAsync(userId, TopicId, Choice, ct), m => _error = m))
            _gaps = found;
    }

    private async Task WriteNoteAsync(Gap gap)
    {
        _error = null;
        var userId = await UserIdAsync();
        AddedMaterial? added = null;
        if (!await RunBusyAsync($"Writing a study note on {gap.Title}...", async (_, ct) =>
                added = await Gaps.WriteNoteAsync(userId, TopicId, gap, Choice, ct), m => _error = m) || added is null)
            return;

        _written[gap.Title] = added.Id;
        // Outlined like any other material, so exams can use it.
        Analysis.Enqueue(userId, added.Id, _settings!.AdvancedModels ? _settings.Default(AiTask.Analysis) : null);
        Ui.Toast.Success("Study note added to the topic's material. It's marked as written by the AI.");
    }
}

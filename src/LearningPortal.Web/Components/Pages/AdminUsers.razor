@page "/admin/users"
@attribute [Authorize(Roles = Roles.Admin)]
@inherits AppPage
@inject UserAdminService Users
@inject AccountMailService Mail
@inject AccountRequestService Requests
@inject AdminStatisticsService Stats
@inject IJSRuntime JS

<PageTitle>Users - @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>Users</h1>
        <p class="page-sub">
            Create an account here and the person gets an invite link to choose their own password, or let
            people request an account for you to approve. Each person's topics and results are private.
        </p>
    </div>
</div>

<div class="two-col">
    <section>
        @if (_requests.Count > 0)
        {
            <div class="section-head"><h2>Account requests<span class="count">@_requests.Count</span></h2></div>
            <ul class="rows" style="margin-bottom:28px">
                @foreach (var r in _requests)
                {
                    var request = r;
                    <li class="row" @key="request.Id">
                        <div class="row-main">
                            <span class="row-title">@request.Name</span>
                            <div class="row-meta"><span>@request.Email</span><span>@Format.Date(request.CreatedAt)</span></div>
                            @if (request.Message is not null)
                            {
                                <p class="small" style="margin:6px 0 0;white-space:pre-line">@request.Message</p>
                            }
                        </div>
                        <div class="row-actions">
                            <button type="button" class="btn btn-primary btn-sm" disabled="@_sending" @onclick="() => ApproveAsync(request)">Approve</button>
                            <button type="button" class="btn btn-ghost btn-sm" disabled="@_sending" @onclick="() => DeclineAsync(request)">Decline</button>
                        </div>
                    </li>
                }
            </ul>
        }

        @if (_link is not null)
        {
            <div class="notice notice-warn" style="margin-bottom:18px" role="status">
                <strong>@_link.Title</strong>
                <div>@_link.Reason Copy the link and send it to them yourself. @_link.Validity</div>
                <div class="link-copy">
                    <input class="input" readonly value="@_link.Url" aria-label="Link" onfocus="this.select()" />
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CopyLinkAsync">Copy link</button>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _link = null">Done</button>
            </div>
        }

        <div class="section-head">
            <h2>Accounts<span class="count">@_users.Count</span></h2>
            <label class="sort-pick">
                <span class="muted small">Sort by</span>
                <select class="select select-sm" @bind="_sort">
                    <option value="@Sort.Name">Name</option>
                    <option value="@Sort.LastActive">Last active</option>
                    <option value="@Sort.Attempts">Attempts</option>
                </select>
            </label>
        </div>
        <p class="muted small" style="margin-top:8px">
            Activity counts and dates only: you never see what anyone's topics or questions are about.
            Last active updates at most every @((int)UserActivityService.ActiveResolution.TotalMinutes) minutes.
        </p>
        <ul class="rows">
            @foreach (var u in Sorted())
            {
                var isMe = u.Id == _myId;
                var usage = _usage.GetValueOrDefault(u.Id);
                <li class="row" @key="u.Id">
                    <div class="row-main">
                        <span class="row-title">@u.ShownName @(isMe ? "(you)" : "")</span>
                        <div class="row-meta">
                            <span>@(u.IsAdmin ? "Administrator" : "User")</span>
                            <span>@(u.Email ?? "No email address")</span>
                            @* Older accounts sign in with their own username as well. *@
                            @if (!string.Equals(u.UserName, u.Email, StringComparison.OrdinalIgnoreCase))
                            {
                                <span>Username @u.UserName</span>
                            }
                            @if (!u.HasPassword)
                            {
                                <span class="tag">Invite pending</span>
                            }
                            <span>Created @Format.Ago(u.CreatedAt)</span>
                        </div>
                        @if (usage is not null)
                        {
                            <div class="row-meta">
                                <span title="@(usage.LastActiveAt is { } at ? Format.Date(at) : "")">
                                    @(usage.LastActiveAt is { } active ? $"Last active {Format.Ago(active)}" : "Not active yet")
                                </span>
                                <span>@Format.Plural(usage.Topics, "topic", "topics")</span>
                                <span>@Format.Plural(usage.Exams, "exam", "exams")</span>
                                <span>@Format.Plural(usage.BankQuestions, "bank question", "bank questions")</span>
                                <span>@Format.Plural(usage.Attempts, "attempt", "attempts")</span>
                            </div>
                        }
                    </div>
                    <div class="row-actions">
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_sending" @onclick="() => SendLinkAsync(u)">@(u.HasPassword ? "Send reset link" : "Resend invite")</button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => EditEmailAsync(u)">@(u.Email is null ? "Add email" : "Change email")</button>
                        @if (!isMe)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleAdminAsync(u)">@(u.IsAdmin ? "Remove admin" : "Make admin")</button>
                            <button type="button" class="btn btn-ghost btn-icon btn-sm" aria-label="Delete @u.ShownName" @onclick="() => DeleteAsync(u)"><Icon Name="trash" Size="16" /></button>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    <aside>
        <div class="panel">
            <h2>Create account</h2>
            <form class="form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>Email address</span>
                    <input class="input" type="email" @bind="_newEmail" @bind:event="oninput" autocomplete="off" spellcheck="false" />
                    <span class="field-hint">
                        They sign in with this.
                        @if (_emailOn)
                        {
                            @:The invite link goes here too.
                        }
                        else
                        {
                            @:Email isn't set up, so you'll get the invite link to pass on yourself.
                        }
                    </span>
                </label>
                <label class="field">
                    <span>Display name <span class="muted">(optional)</span></span>
                    <input class="input" @bind="_newName" @bind:event="oninput" autocomplete="off" maxlength="@AppUser.MaxDisplayNameLength" />
                    <span class="field-hint">Without one, the first part of their email is shown. They can change it later.</span>
                </label>
                <label class="check">
                    <input type="checkbox" @bind="_newAdmin" /> Administrator
                </label>
                @foreach (var e in _errors)
                {
                    <div class="field-error">@e</div>
                }
                <button type="submit" class="btn btn-primary" disabled="@(_sending || string.IsNullOrWhiteSpace(_newEmail))">
                    @(_emailOn ? "Create and send invite" : "Create account")
                </button>
            </form>
        </div>

        <div class="panel">
            <h2>Account requests</h2>
            <label class="check">
                <input type="checkbox" checked="@_requestsOpen" disabled="@(!_emailOn && !_requestsOpen)" @onchange="e => SetRequestsOpenAsync((bool)e.Value!)" />
                Let people request an account
            </label>
            <p class="muted small" style="margin-top:6px">
                @if (!_emailOn)
                {
                    @:Needs email to be on, since approval and decline are sent by email.
                }
                else
                {
                    @:Adds "Request an account" to the sign-in page. You approve or decline each request here; approving sends the usual invite.
                }
            </p>
        </div>

        <div class="panel">
            <h2>Email</h2>
            <p class="muted small">
                @if (_emailOn)
                {
                    @:Email is on: invites and reset links are sent by email, and anyone can use "Forgot password?" on the sign-in page.
                }
                else
                {
                    @:Email is off, so invite and reset links are shown here for you to pass on, and "Forgot password?" on the sign-in page tells people to ask you.
                }
            </p>
            <a class="btn btn-ghost btn-sm" href="admin/email">Email settings</a>
        </div>
    </aside>
</div>

@code {
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private sealed record LinkToShare(string Title, string Reason, string Url, string Validity);

    private enum Sort { Name, LastActive, Attempts }

    private IReadOnlyList<UserRow> _users = [];
    private IReadOnlyDictionary<string, UserUsage> _usage = new Dictionary<string, UserUsage>();
    private Sort _sort = Sort.Name;
    private string _myId = "";
    private string _newName = "";
    private string _newEmail = "";
    private bool _newAdmin;
    private bool _sending;
    private bool _emailOn;
    private List<string> _errors = [];
    private LinkToShare? _link;
    private IReadOnlyList<AccountRequestView> _requests = [];
    private bool _requestsOpen;

    protected override async Task OnInitializedAsync()
    {
        _myId = await UserIdAsync();
        _users = await Users.ListAsync();
        _usage = await Stats.GetUsageAsync(PageToken);
        _emailOn = await Mail.EmailConfiguredAsync();
        _requests = await Requests.ListAsync(PageToken);
        _requestsOpen = await Requests.IsOpenAsync(PageToken);
    }

    // Names A to Z (as listed); activity and attempts newest or largest first.
    private IEnumerable<UserRow> Sorted() => _sort switch
    {
        Sort.LastActive => _users.OrderByDescending(u => _usage.GetValueOrDefault(u.Id)?.LastActiveAt ?? DateTime.MinValue),
        Sort.Attempts => _users.OrderByDescending(u => _usage.GetValueOrDefault(u.Id)?.Attempts ?? 0),
        _ => _users,
    };

    private async Task SetRequestsOpenAsync(bool open)
    {
        _requestsOpen = open;
        await Requests.SetOpenAsync(open, PageToken);
        Ui.Toast.Success(open ? "People can now request an account from the sign-in page." : "Account requests are closed.");
    }

    // Creates the account and sends the normal invite; the request is then done.
    private async Task ApproveAsync(AccountRequestView request)
    {
        _sending = true;
        try
        {
            var (userId, errors) = await Users.CreateAsync(request.Email, request.Name, isAdmin: false);
            if (userId is null)
            {
                Ui.Toast.Error(string.Join(" ", errors));
                return;
            }
            await Requests.DeleteAsync(request.Id, PageToken);
            _requests = await Requests.ListAsync(PageToken);
            _users = await Users.ListAsync();
            await DeliverAsync(userId, request.Name, isInvite: true, $"Account for {request.Name} created.");
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task DeclineAsync(AccountRequestView request)
    {
        var note = await Ui.Prompt.AskAsync("Decline request", $"Note to {request.Name} (optional)", "", "Decline",
            hint: "They get a short email saying the request wasn't approved. A note is added to it if you write one.",
            multiline: true, allowEmpty: true);
        if (note is null)
            return;

        _sending = true;
        try
        {
            var failed = await Mail.SendRequestDeclinedAsync(request, note, PageToken);
            await Requests.DeleteAsync(request.Id, PageToken);
            _requests = await Requests.ListAsync(PageToken);
            if (failed is null)
                Ui.Toast.Success($"Request from {request.Name} declined. They've been told by email.");
            else
                Ui.Toast.Error($"Request from {request.Name} declined, but they couldn't be told: {failed}");
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task CreateAsync()
    {
        _sending = true;
        try
        {
            var (userId, errors) = await Users.CreateAsync(_newEmail, _newName, _newAdmin);
            _errors = errors.ToList();
            if (userId is null) return;

            var name = AppUser.ShownNameFor(_newName, _newEmail.Trim(), null);
            _newName = "";
            _newEmail = "";
            _newAdmin = false;
            _users = await Users.ListAsync();
            await DeliverAsync(userId, name, isInvite: true, $"Account for {name} created.");
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task SendLinkAsync(UserRow u)
    {
        _sending = true;
        try
        {
            await DeliverAsync(u.Id, u.ShownName, isInvite: !u.HasPassword, prefix: null);
        }
        finally
        {
            _sending = false;
        }
    }

    // Emails the invite or reset link, or shows it for the admin to pass on when it can't be emailed.
    private async Task DeliverAsync(string userId, string shownName, bool isInvite, string? prefix)
    {
        var what = isInvite ? "Invite" : "Password reset link";
        PasswordLinkResult result;
        try
        {
            result = await Mail.SendLinkAsync(userId, Nav.BaseUri, PageToken);
        }
        catch (InvalidOperationException ex)
        {
            Ui.Toast.Error(ex.Message);
            return;
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (result.Emailed)
        {
            _link = null;
            Ui.Toast.Success($"{prefix} {what} sent to {result.SentTo}.".Trim());
            return;
        }

        if (prefix is not null)
            Ui.Toast.Success(prefix);
        var lifespan = isInvite ? AccountMailService.InviteLifespan : AccountMailService.ResetLifespan;
        _link = new LinkToShare(
            $"{what} for {shownName}",
            result.Reason ?? "",
            result.Link!,
            $"It works once and expires in {(lifespan.TotalDays >= 1 ? $"{lifespan.TotalDays:0} days" : $"{lifespan.TotalHours:0} hours")}.");
        await JS.InvokeVoidAsync("learningPortal.scrollToTop");
    }

    private async Task CopyLinkAsync()
    {
        if (_link is null) return;
        if (await JS.InvokeAsync<bool>("learningPortal.copyText", _link.Url))
            Ui.Toast.Success("Link copied.");
        else
            Ui.Toast.Error("The browser didn't allow copying. Select the link and copy it by hand.");
    }

    private async Task EditEmailAsync(UserRow u)
    {
        var email = await Ui.Prompt.AskAsync($"Email address for {u.ShownName}", "Email address", u.Email ?? "", okLabel: "Save",
            hint: "They sign in with it, and invites and reset links go there.");
        if (email is null) return;

        var errors = await Users.SetEmailAsync(u.Id, email);
        if (errors.Count > 0)
        {
            Ui.Toast.Error(string.Join(" ", errors));
            return;
        }
        Ui.Toast.Success($"Email address for {u.ShownName} saved.");
        _users = await Users.ListAsync();
    }

    private async Task ToggleAdminAsync(UserRow u)
    {
        // Granting admin is the risky direction; removing it is easy to undo, so it doesn't ask.
        if (!u.IsAdmin && !await Ui.Confirm.AskAsync($"Make {u.ShownName} an admin?",
                "They'll be able to create, edit and delete every account, including yours, and change the email settings.",
                "Make admin", danger: true))
            return;
        await Users.SetAdminAsync(u.Id, !u.IsAdmin);
        _users = await Users.ListAsync();
    }

    private async Task DeleteAsync(UserRow u)
    {
        if (!await Ui.Confirm.AskAsync($"Delete {u.ShownName}?",
                "Their account and all their topics, material, exams and results are deleted. This can't be undone.",
                "Delete account", danger: true))
            return;
        await Users.DeleteAsync(u.Id);
        Ui.Toast.Success($"{u.ShownName} deleted.");
        _users = await Users.ListAsync();
    }
}

@page "/admin/users"
@attribute [Authorize(Roles = Roles.Admin)]
@inherits AppPage
@inject UserAdminService Users
@inject AccountMailService Mail
@inject IJSRuntime JS

<PageTitle>Users - @AppInfo.Name</PageTitle>

<div class="page-head">
    <div>
        <h1>Users</h1>
        <p class="page-sub">
            There's no public sign-up. Create an account here and the person gets an invite link to choose
            their own password. Each person's topics and results are private.
        </p>
    </div>
</div>

<div class="two-col">
    <section>
        @if (_link is not null)
        {
            <div class="notice notice-warn" style="margin-bottom:18px" role="status">
                <strong>@_link.Title</strong>
                <div>@_link.Reason Copy the link and send it to them yourself. @_link.Validity</div>
                <div class="link-copy">
                    <input class="input" readonly value="@_link.Url" aria-label="Link" onfocus="this.select()" />
                    <button type="button" class="btn btn-primary btn-sm" @onclick="CopyLinkAsync">Copy link</button>
                </div>
                <button type="button" class="btn btn-ghost btn-sm" @onclick="() => _link = null">Done</button>
            </div>
        }

        <div class="section-head"><h2>Accounts<span class="count">@_users.Count</span></h2></div>
        <ul class="rows">
            @foreach (var u in _users)
            {
                var isMe = u.Id == _myId;
                <li class="row" @key="u.Id">
                    <div class="row-main">
                        <span class="row-title">@u.UserName @(isMe ? "(you)" : "")</span>
                        <div class="row-meta">
                            <span>@(u.IsAdmin ? "Administrator" : "User")</span>
                            <span>@(u.Email ?? "No email address")</span>
                            @if (!u.HasPassword)
                            {
                                <span class="tag">Invite pending</span>
                            }
                            <span>Created @Format.Ago(u.CreatedAt)</span>
                        </div>
                    </div>
                    <div class="row-actions">
                        <button type="button" class="btn btn-ghost btn-sm" disabled="@_sending" @onclick="() => SendLinkAsync(u)">@(u.HasPassword ? "Send reset link" : "Resend invite")</button>
                        <button type="button" class="btn btn-ghost btn-sm" @onclick="() => EditEmailAsync(u)">@(u.Email is null ? "Add email" : "Change email")</button>
                        @if (!isMe)
                        {
                            <button type="button" class="btn btn-ghost btn-sm" @onclick="() => ToggleAdminAsync(u)">@(u.IsAdmin ? "Remove admin" : "Make admin")</button>
                            <button type="button" class="btn btn-ghost btn-icon btn-sm" aria-label="Delete @u.UserName" @onclick="() => DeleteAsync(u)"><Icon Name="trash" Size="16" /></button>
                        }
                    </div>
                </li>
            }
        </ul>
    </section>

    <aside>
        <div class="panel">
            <h2>Create account</h2>
            <form class="form" @onsubmit="CreateAsync" @onsubmit:preventDefault="true">
                <label class="field">
                    <span>Username</span>
                    <input class="input" @bind="_newName" @bind:event="oninput" autocomplete="off" />
                    <span class="field-hint">Letters, digits and - . _ @@ +</span>
                </label>
                <label class="field">
                    <span>Email address</span>
                    <input class="input" type="email" @bind="_newEmail" @bind:event="oninput" autocomplete="off" spellcheck="false" />
                    <span class="field-hint">
                        @if (_emailOn)
                        {
                            @:The invite link goes here. They use this address to reset a forgotten password too.
                        }
                        else
                        {
                            @:Email isn't set up, so you'll get the invite link to pass on yourself.
                        }
                    </span>
                </label>
                <label class="check">
                    <input type="checkbox" @bind="_newAdmin" /> Administrator
                </label>
                @foreach (var e in _errors)
                {
                    <div class="field-error">@e</div>
                }
                <button type="submit" class="btn btn-primary" disabled="@(_sending || string.IsNullOrWhiteSpace(_newName) || string.IsNullOrWhiteSpace(_newEmail))">
                    @(_emailOn ? "Create and send invite" : "Create account")
                </button>
            </form>
        </div>

        <div class="panel">
            <h2>Email</h2>
            <p class="muted small">
                @if (_emailOn)
                {
                    @:Email is on: invites and reset links are sent by email, and anyone can use "Forgot password?" on the sign-in page.
                }
                else
                {
                    @:Email is off, so invite and reset links are shown here for you to pass on, and "Forgot password?" on the sign-in page tells people to ask you.
                }
            </p>
            <a class="btn btn-ghost btn-sm" href="admin/email">Email settings</a>
        </div>
    </aside>
</div>

@code {
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private sealed record LinkToShare(string Title, string Reason, string Url, string Validity);

    private IReadOnlyList<UserRow> _users = [];
    private string _myId = "";
    private string _newName = "";
    private string _newEmail = "";
    private bool _newAdmin;
    private bool _sending;
    private bool _emailOn;
    private List<string> _errors = [];
    private LinkToShare? _link;

    protected override async Task OnInitializedAsync()
    {
        _myId = await UserIdAsync();
        _users = await Users.ListAsync();
        _emailOn = await Mail.EmailConfiguredAsync();
    }

    private async Task CreateAsync()
    {
        _sending = true;
        try
        {
            var name = _newName.Trim();
            var (userId, errors) = await Users.CreateAsync(name, _newEmail, _newAdmin);
            _errors = errors.ToList();
            if (userId is null) return;

            _newName = "";
            _newEmail = "";
            _newAdmin = false;
            _users = await Users.ListAsync();
            await DeliverAsync(userId, name, isInvite: true, $"Account \"{name}\" created.");
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task SendLinkAsync(UserRow u)
    {
        _sending = true;
        try
        {
            await DeliverAsync(u.Id, u.UserName, isInvite: !u.HasPassword, prefix: null);
        }
        finally
        {
            _sending = false;
        }
    }

    // Emails the invite or reset link, or shows it for the admin to pass on when it can't be emailed.
    private async Task DeliverAsync(string userId, string userName, bool isInvite, string? prefix)
    {
        var what = isInvite ? "Invite" : "Password reset link";
        PasswordLinkResult result;
        try
        {
            result = await Mail.SendLinkAsync(userId, Nav.BaseUri, PageToken);
        }
        catch (InvalidOperationException ex)
        {
            Ui.Toast.Error(ex.Message);
            return;
        }
        catch (OperationCanceledException)
        {
            return;
        }

        if (result.Emailed)
        {
            _link = null;
            Ui.Toast.Success($"{prefix} {what} sent to {result.SentTo}.".Trim());
            return;
        }

        if (prefix is not null)
            Ui.Toast.Success(prefix);
        var lifespan = isInvite ? AccountMailService.InviteLifespan : AccountMailService.ResetLifespan;
        _link = new LinkToShare(
            $"{what} for {userName}",
            result.Reason ?? "",
            result.Link!,
            $"It works once and expires in {(lifespan.TotalDays >= 1 ? $"{lifespan.TotalDays:0} days" : $"{lifespan.TotalHours:0} hours")}.");
        await JS.InvokeVoidAsync("learningPortal.scrollToTop");
    }

    private async Task CopyLinkAsync()
    {
        if (_link is null) return;
        if (await JS.InvokeAsync<bool>("learningPortal.copyText", _link.Url))
            Ui.Toast.Success("Link copied.");
        else
            Ui.Toast.Error("The browser didn't allow copying. Select the link and copy it by hand.");
    }

    private async Task EditEmailAsync(UserRow u)
    {
        var email = await Ui.Prompt.AskAsync($"Email address for {u.UserName}", "Email address", u.Email ?? "", okLabel: "Save",
            hint: "Used for invites and to reset a forgotten password.");
        if (email is null) return;

        var errors = await Users.SetEmailAsync(u.Id, email);
        if (errors.Count > 0)
        {
            Ui.Toast.Error(string.Join(" ", errors));
            return;
        }
        Ui.Toast.Success($"Email address for {u.UserName} saved.");
        _users = await Users.ListAsync();
    }

    private async Task ToggleAdminAsync(UserRow u)
    {
        await Users.SetAdminAsync(u.Id, !u.IsAdmin);
        _users = await Users.ListAsync();
    }

    private async Task DeleteAsync(UserRow u)
    {
        if (!await Ui.Confirm.AskAsync($"Delete {u.UserName}?",
                "Their account and all their topics, material, exams and results are deleted. This can't be undone.",
                "Delete account", danger: true))
            return;
        await Users.DeleteAsync(u.Id);
        Ui.Toast.Success($"{u.UserName} deleted.");
        _users = await Users.ListAsync();
    }
}

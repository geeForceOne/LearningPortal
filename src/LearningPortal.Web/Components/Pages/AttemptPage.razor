@page "/attempts/{AttemptId:int}"
@inherits AppPage
@inject AttemptService Attempts
@inject PracticeService Practice
@inject IJSRuntime JS

<PageTitle>@(_view?.Exam.Name ?? "Exam") - @AppInfo.Name</PageTitle>

@if (_view is null)
{
    <p class="page-loading">Loading...</p>
}
else if (_view.IsFinished)
{
    @Results()
}
else
{
    @Taking()
}

@code {
    [Parameter] public int AttemptId { get; set; }
    [CascadingParameter] private AppUi Ui { get; set; } = default!;

    private AttemptView? _view;
    private int _index;
    private readonly HashSet<int> _selected = [];
    private string _written = "";
    private DateTime _shownAt = DateTime.UtcNow;
    private bool _revealImmediately;
    private string? _error;

    private AttemptAnswer Current => _view!.Answers[_index];
    private Question CurrentQuestion => Current.Question!;

    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync(jumpToFirstOpen: true);
        try
        {
            _revealImmediately = await JS.InvokeAsync<string?>("learningPortal.getPref", "revealImmediately") == "1";
        }
        catch (JSException)
        {
        }
    }

    private async Task LoadAsync(bool jumpToFirstOpen = false)
    {
        try
        {
            _view = await Attempts.GetAsync(await UserIdAsync(), AttemptId, PageToken);
        }
        catch (NotFoundException)
        {
            Nav.NavigateTo("not-found");
            return;
        }

        if (jumpToFirstOpen && !_view.IsFinished)
        {
            var open = _view.Answers.ToList().FindIndex(a => !a.IsAnswered);
            GoTo(open >= 0 ? open : _view.Answers.Count - 1);
        }
    }

    private void GoTo(int index)
    {
        _index = Math.Clamp(index, 0, _view!.Answers.Count - 1);
        _selected.Clear();
        _written = "";
        _error = null;
        _shownAt = DateTime.UtcNow;
    }

    private int ElapsedSeconds() => (int)(DateTime.UtcNow - _shownAt).TotalSeconds;

    private string RailClass(AttemptAnswer a, int i)
    {
        var cls = i == _index ? "is-current " : "";
        if (!a.IsAnswered) return cls;
        if (!a.Revealed || a.Score is null) return cls + "is-answered";
        return cls + "is-" + VerdictRules.FromScore(a.Score.Value).ToString().ToLowerInvariant();
    }

    private string RailLabel(AttemptAnswer a, int i)
    {
        var state = !a.IsAnswered ? "not answered" : a.Revealed && a.DontKnow ? "didn't know" : a.Revealed && a.Score is { } s ? $"{VerdictRules.FromScore(s)}".ToLowerInvariant() : "answered";
        return $"Question {i + 1}, {state}";
    }

    private void Toggle(int optionId)
    {
        if (CurrentQuestion.AllowsMultiple)
        {
            if (!_selected.Remove(optionId)) _selected.Add(optionId);
        }
        else
        {
            _selected.Clear();
            _selected.Add(optionId);
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        var userId = await UserIdAsync();
        var answerId = Current.Id;
        var elapsed = ElapsedSeconds();

        if (CurrentQuestion.Type == QuestionType.MultipleChoice)
        {
            try
            {
                await Attempts.AnswerChoiceAsync(userId, AttemptId, answerId, _selected.ToList(), elapsed, PageToken);
            }
            catch (ArgumentException ex)
            {
                _error = ex.Message;
                return;
            }
        }
        else
        {
            var text = _written;
            string? failure = null;
            await RunBusyAsync("Saving and grading your answer...", async (_, ct) =>
                await Attempts.AnswerWrittenAsync(userId, AttemptId, answerId, text, elapsed, ct), m => failure = m);

            if (failure is not null)
            {
                await LoadAsync();
                // The answer is saved before grading starts, so a grading failure loses nothing.
                _error = Current.IsAnswered
                    ? $"Your answer is saved, but grading failed: {failure} It's graded again when you finish"
                      + (_revealImmediately ? ", or use Grade now below." : ".")
                    : failure;
                if (!Current.IsAnswered)
                    return;
            }
        }

        await AfterAnswerAsync(userId, answerId);
    }

    private async Task DontKnowAsync()
    {
        _error = null;
        var userId = await UserIdAsync();
        var answerId = Current.Id;
        await Attempts.AnswerDontKnowAsync(userId, AttemptId, answerId, ElapsedSeconds(), PageToken);
        await AfterAnswerAsync(userId, answerId);
    }

    private async Task AfterAnswerAsync(string userId, int answerId)
    {
        if (_revealImmediately)
        {
            await Attempts.RevealAsync(userId, AttemptId, answerId, PageToken);
            await LoadAsync();
            return;
        }

        // Answers are revealed at the end, so move straight on. A grading error stays on screen instead.
        await LoadAsync();
        if (_error is null && NextOpenIndex() is >= 0 and var open)
            await MoveToAsync(open);
    }

    private async Task RetryGradeAsync(int answerId)
    {
        _error = null;
        await RunBusyAsync("Grading your answer...", async (_, ct) =>
            await Attempts.GradeAsync(await UserIdAsync(), AttemptId, answerId, ct), m => _error = m);
        await LoadAsync();
    }

    // The next unanswered question after this one, wrapping round to the start; -1 when there's
    // no other one.
    private int NextOpenIndex()
    {
        var answers = _view!.Answers;
        for (var step = 1; step < answers.Count; step++)
        {
            var i = (_index + step) % answers.Count;
            if (!answers[i].IsAnswered)
                return i;
        }
        return -1;
    }

    // "Next" is the question after this one, answered or not. Past the last one there's no next;
    // the button there goes to the first question still open instead (see Taking).
    private Task NextAsync() => MoveToAsync(_index + 1);

    private Task PreviousAsync() => MoveToAsync(_index - 1);

    // Leaving a question unanswered (skipping it, or going back) keeps the time spent on it.
    private async Task MoveToAsync(int index)
    {
        if (!Current.IsAnswered && ElapsedSeconds() is > 0 and var seconds)
        {
            try { await Attempts.AddActiveTimeAsync(await UserIdAsync(), AttemptId, seconds); }
            catch { /* best effort */ }
        }
        GoTo(index);
        await ScrollTopAsync();
    }

    // "2", "2 and 5", "2, 4 and 5"
    private static string NumberList(IReadOnlyList<int> numbers) => numbers.Count switch
    {
        0 => "",
        1 => $"{numbers[0]}",
        _ => $"{string.Join(", ", numbers.Take(numbers.Count - 1))} and {numbers[^1]}",
    };

    private async Task SetRevealPreference(bool value)
    {
        _revealImmediately = value;
        try { await JS.InvokeVoidAsync("learningPortal.setPref", "revealImmediately", value ? "1" : "0"); }
        catch (JSException) { }
    }

    private async Task FinishAsync()
    {
        var open = _view!.Answers.Select((a, i) => (Answer: a, Number: i + 1)).Where(x => !x.Answer.IsAnswered).Select(x => x.Number).ToList();
        // A few are named; a long list (finishing early) is just counted.
        var which = open.Count switch
        {
            1 => $"Question {open[0]} is",
            <= 5 => $"Questions {NumberList(open)} are",
            _ => $"{open.Count} questions are",
        };
        if (open.Count > 0 && !await Ui.Confirm.AskAsync("Finish the exam?",
                $"{which} still unanswered and will count as incorrect.",
                "Finish exam"))
            return;

        _error = null;
        var userId = await UserIdAsync();
        var elapsed = Current.IsAnswered ? 0 : ElapsedSeconds();
        var ok = await RunBusyAsync("Finishing...", async (progress, ct) =>
            await Attempts.FinishAsync(userId, AttemptId, elapsed, progress, ct), m => _error = m);
        if (ok)
        {
            await LoadAsync();
            await ScrollTopAsync();
        }
    }

    private async Task TakeAgainAsync()
    {
        var id = await Attempts.StartNewAsync(await UserIdAsync(), _view!.Exam.Id, PageToken);
        Nav.NavigateTo($"attempts/{id}");
    }

    // The practice has no exam page of its own; its topic is where it's started.
    private string ExamHref => _view!.Exam.IsPractice ? $"topics/{_view.Topic.Id}" : $"exams/{_view.Exam.Id}";

    private async Task PracticeAgainAsync()
    {
        try
        {
            var id = await Practice.StartAsync(await UserIdAsync(), _view!.Topic.Id, _view.Answers.Count, PageToken);
            Nav.NavigateTo($"attempts/{id}");
        }
        catch (InvalidOperationException ex)
        {
            Ui.Toast.Error(ex.Message);
        }
    }

    private async Task SaveAsExamAsync()
    {
        var name = await Ui.Prompt.AskAsync("Save as exam", "Exam name",
            $"{_view!.Exam.Name}, {DateTime.Now.ToString("d MMM", System.Globalization.CultureInfo.InvariantCulture)}", "Save");
        if (name is null)
            return;
        try
        {
            var examId = await Practice.SaveAsExamAsync(await UserIdAsync(), AttemptId, name, PageToken);
            Nav.NavigateTo($"exams/{examId}");
        }
        catch (ArgumentException ex)
        {
            Ui.Toast.Error(ex.Message);
        }
    }

    private async Task ScrollTopAsync()
    {
        try { await JS.InvokeVoidAsync("learningPortal.scrollToTop"); } catch (JSException) { }
    }

    private static bool HasCode(string text) => text.Contains("```") || text.Contains("~~~");

    private static int CountSentences(string text) =>
        System.Text.RegularExpressions.Regex.Matches(text.Trim(), @"[^.!?]+[.!?]*").Count(m => m.Value.Trim().Length > 1);

    // Time spent on a question the user leaves without answering still counts toward the attempt.
    public override void Dispose()
    {
        if (_view is { IsFinished: false } && !Current.IsAnswered)
        {
            var seconds = ElapsedSeconds();
            var attemptId = AttemptId;
            _ = Task.Run(async () =>
            {
                try { await Attempts.AddActiveTimeAsync(await UserIdAsync(), attemptId, seconds); }
                catch { /* best effort */ }
            });
        }
        base.Dispose();
    }

    private RenderFragment Taking() => __builder =>
    {
        var q = CurrentQuestion;
        var a = Current;
        var nextOpen = NextOpenIndex();
        <div class="exam">
            <div class="exam-top">
                <a href="@ExamHref" class="muted" style="text-decoration:none">&larr; @_view!.Exam.Name</a>
                <span>@_view.AnsweredCount of @_view.Answers.Count answered</span>
            </div>

            <nav class="rail" aria-label="Questions">
                @for (var i = 0; i < _view.Answers.Count; i++)
                {
                    var index = i;
                    var item = _view.Answers[i];
                    <button type="button" class="@RailClass(item, index)" aria-label="@RailLabel(item, index)"
                            aria-current="@(index == _index ? "step" : null)" @onclick="() => GoTo(index)"></button>
                }
            </nav>

            <div class="question-meta">
                <span class="question-number">Question @(_index + 1) of @_view.Answers.Count</span>
                <span class="tag">@Format.Label(q.Difficulty)</span>
            </div>

            <div class="prompt" role="heading" aria-level="1"><RichText Text="@q.Prompt" /></div>

            @if (a.IsAnswered && a.Revealed)
            {
                <AnswerReview Answer="a" OnRetryGrade="() => RetryGradeAsync(a.Id)" AttemptId="AttemptId" />
            }
            else if (a.IsAnswered)
            {
                <div class="notice" style="margin-top:12px">
                    Your answer is saved. You'll see the answer and explanation at the end.
                </div>
            }
            else if (q.Type == QuestionType.MultipleChoice)
            {
                <div class="kind-hint">
                    @if (q.AllowsMultiple)
                    {
                        <Icon Name="check" Size="16" /><span>Choose all that apply</span>
                    }
                    else
                    {
                        <span>Choose one</span>
                    }
                </div>
                <fieldset class="options @(q.AllowsMultiple ? "multi" : "")">
                    <legend class="visually-hidden">@(q.AllowsMultiple ? "Choose all that apply" : "Choose one")</legend>
                    @foreach (var optionId in a.OptionOrderIds)
                    {
                        var option = q.Options.FirstOrDefault(o => o.Id == optionId);
                        if (option is null) continue;
                        var id = option.Id;
                        <label class="option" @key="id">
                            <input type="@(q.AllowsMultiple ? "checkbox" : "radio")" name="answer-@a.Id" checked="@_selected.Contains(id)"
                                   @onchange="() => Toggle(id)" disabled="@IsBusy" />
                            <span class="option-box" aria-hidden="true"></span>
                            <span class="option-text"><RichText Text="@option.Text" /></span>
                        </label>
                    }
                </fieldset>
            }
            else
            {
                var sentences = CountSentences(_written);
                // With code in the question, answers may contain code too: monospace keeps it readable,
                // and sentences aren't counted since every "." in code would count as one.
                var codeQuestion = HasCode(q.Prompt);
                <div class="answer-box">
                    <label for="written-answer" class="kind-hint" style="margin-bottom:4px">Your answer</label>
                    <textarea id="written-answer" class="textarea @(codeQuestion ? "code-answer" : "")" maxlength="@AttemptService.MaxWrittenAnswerLength"
                              @bind="_written" @bind:event="oninput" disabled="@IsBusy"
                              placeholder="Write it in your own words. Short is fine: the grader looks for the key ideas, not length."></textarea>
                    <div class="answer-foot">
                        <span>Aim for about @AttemptService.SuggestedWrittenAnswerSentences sentences@(codeQuestion ? " or a few lines of code" : ""). Longer is fine when the question needs it.</span>
                        <span class="@(_written.Length > AttemptService.SuggestedWrittenAnswerLength || (!codeQuestion && sentences > AttemptService.SuggestedWrittenAnswerSentences) ? "over" : "")">
                            @if (!codeQuestion)
                            {
                                @($"{Format.Plural(sentences, "sentence", "sentences")}, ")
                            }
                            @Format.AnswerLength(_written.Length)
                        </span>
                    </div>
                </div>
            }

            @if (_error is not null)
            {
                <div class="notice notice-error" style="margin-top:16px">@_error</div>
            }
            @if (IsBusy)
            {
                <div style="margin-top:16px"><BusyBar Message="@BusyMessage" /></div>
            }

            @* At the end, skipped questions are easy to forget: name them, each a way back. *@
            @if (_index == _view.Answers.Count - 1 && nextOpen >= 0)
            {
                var skipped = Enumerable.Range(0, _view.Answers.Count).Where(i => i != _index && !_view.Answers[i].IsAnswered).ToList();
                <div class="notice" style="margin-top:16px">
                    @(skipped.Count == 1 ? "Question" : "Questions")
                    @for (var i = 0; i < skipped.Count; i++)
                    {
                        var target = skipped[i];
                        var separator = i == 0 ? " " : i == skipped.Count - 1 ? " and " : ", ";
                        @separator<button type="button" class="link-button" disabled="@IsBusy" @onclick="() => MoveToAsync(target)">@(target + 1)</button>
                    }
                    @(skipped.Count == 1 ? " isn't answered yet." : " aren't answered yet.")
                </div>
            }

            @if (!a.IsAnswered)
            {
                var canSubmit = q.Type == QuestionType.MultipleChoice ? _selected.Count > 0 : !string.IsNullOrWhiteSpace(_written);
                <div class="exam-actions">
                    <button type="button" class="btn btn-primary btn-lg" disabled="@(IsBusy || !canSubmit)" @onclick="SubmitAsync">
                        @(_revealImmediately ? "Check answer" : "Save answer")
                    </button>
                    <button type="button" class="btn btn-secondary btn-lg" disabled="@IsBusy" @onclick="DontKnowAsync"
                            title="Better than guessing: it counts as incorrect, and the question comes back in weak-question practice.">
                        I don't know
                    </button>
                </div>
            }

            @* Getting around, always in the same place whatever the question's state: back on the
               left, finishing in the middle, on to the next on the right. The one to press next is
               the filled one. *@
            @{
                var last = _index == _view.Answers.Count - 1;
                var allAnswered = _view.AnsweredCount == _view.Answers.Count;
                // Once everything is answered, seeing the results is what's next, wherever you are.
                var forward = a.IsAnswered && !allAnswered ? "btn-primary" : "btn-ghost";
            }
            <div class="exam-nav">
                <button type="button" class="btn btn-ghost" disabled="@(IsBusy || _index == 0)" @onclick="PreviousAsync">
                    <Icon Name="left" Size="16" /> <span>Previous<span class="long"> question</span></span>
                </button>

                <div class="exam-nav-finish">
                    @if (!allAnswered)
                    {
                        <button type="button" class="btn btn-ghost" disabled="@IsBusy" @onclick="FinishAsync">Finish early</button>
                    }
                    else if (!last)
                    {
                        <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="FinishAsync"><Icon Name="flag" Size="16" /> See results</button>
                    }
                </div>

                @if (!last)
                {
                    <button type="button" class="btn @forward" disabled="@IsBusy" @onclick="NextAsync">
                        <span>Next<span class="long"> question</span></span> <Icon Name="right" Size="16" />
                    </button>
                }
                else if (allAnswered)
                {
                    <button type="button" class="btn btn-primary" disabled="@IsBusy" @onclick="FinishAsync"><Icon Name="flag" Size="16" /> See results</button>
                }
                else if (nextOpen >= 0)
                {
                    <button type="button" class="btn @forward" disabled="@IsBusy" @onclick="() => MoveToAsync(nextOpen)">Go to question @(nextOpen + 1)</button>
                }
                else
                {
                    <button type="button" class="btn btn-ghost" disabled><span>Next<span class="long"> question</span></span> <Icon Name="right" Size="16" /></button>
                }
            </div>

            <div style="margin-top:36px;padding-top:16px;border-top:1px solid var(--rule)">
                <label class="check muted">
                    <input type="checkbox" checked="@_revealImmediately" @onchange="e => SetRevealPreference((bool)e.Value!)" />
                    Reveal each answer right after I answer
                </label>
                <p class="muted small" style="margin-top:6px">Answers save as you go. You can leave and continue this attempt later.</p>
            </div>
        </div>
    };

    private RenderFragment Results() => __builder =>
    {
        var attempt = _view!.Attempt;
        var answers = _view.Answers;
        var correct = answers.Count(x => x.Score is { } s && VerdictRules.FromScore(s) == Verdict.Correct);
        var partial = answers.Count(x => x.Score is { } s && VerdictRules.FromScore(s) == Verdict.Partial);
        var wrong = answers.Count - correct - partial;
        var dontKnow = answers.Count(x => x.DontKnow);

        <nav class="crumbs" aria-label="Breadcrumb">
            <a href="">Topics</a><span class="sep">/</span>
            <a href="topics/@_view.Topic.Id">@_view.Topic.Name</a><span class="sep">/</span>
            @if (_view.Exam.IsPractice)
            {
                <span>@_view.Exam.Name</span>
            }
            else
            {
                <a href="exams/@_view.Exam.Id">@_view.Exam.Name</a>
            }
        </nav>

        <div class="exam">
            <h1 style="margin-bottom:22px">Results</h1>
            <div class="score-hero">
                <div class="score-big"><span class="marker">@Format.Percent(attempt.ScorePercent)</span></div>
                <div class="score-facts">
                    <span><strong>@correct</strong> correct, <strong>@partial</strong> partially correct, <strong>@wrong</strong> incorrect@(dontKnow > 0 ? $" ({dontKnow} you didn't know)" : "")</span>
                    <span>Time spent <strong>@Format.Duration(attempt.ActiveSeconds)</strong></span>
                    <span>Finished @Format.Date(attempt.CompletedAt!.Value)</span>
                </div>
            </div>

            @if (_view.Exam.IsPractice)
            {
                <div class="actions" style="margin:20px 0 10px">
                    <button type="button" class="btn btn-primary" @onclick="PracticeAgainAsync"><Icon Name="redo" /> Practice again</button>
                    <button type="button" class="btn btn-secondary" @onclick="SaveAsExamAsync"><Icon Name="plus" /> Save as exam</button>
                    <a class="btn btn-ghost" href="topics/@_view.Topic.Id">Back to topic</a>
                    <a class="btn btn-ghost" href="statistics?topic=@_view.Topic.Id">Statistics</a>
                </div>
                <p class="muted small">Practicing again picks your weakest questions as they are then. "Save as exam" keeps these questions as an exam you can repeat and edit.</p>
            }
            else
            {
                <div class="actions" style="margin:20px 0 10px">
                    <button type="button" class="btn btn-primary" @onclick="TakeAgainAsync"><Icon Name="redo" /> Take again</button>
                    <a class="btn btn-secondary" href="exams/@_view.Exam.Id">Back to exam</a>
                    <a class="btn btn-ghost" href="statistics?topic=@_view.Topic.Id">Statistics</a>
                </div>
                <p class="muted small">Taking it again shuffles the questions and the answer options.</p>
            }

            @for (var i = 0; i < answers.Count; i++)
            {
                var item = answers[i];
                <article class="review-item" @key="item.Id">
                    <div class="question-meta">
                        <span class="question-number">Question @(i + 1)</span>
                        @if (item.Question!.Type == QuestionType.MultipleChoice)
                        {
                            <span class="tag">@(item.Question.AllowsMultiple ? "Choose all that apply" : "Choose one")</span>
                        }
                    </div>
                    <div class="prompt" role="heading" aria-level="2"><RichText Text="@item.Question.Prompt" /></div>
                    <AnswerReview Answer="item" AttemptId="AttemptId" />
                </article>
            }
        </div>
    };
}
